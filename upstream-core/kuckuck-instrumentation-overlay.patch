+    for (int i = 0; i < p->num_inputs; i++) {
+        const struct ra_renderpass_input *in = &p->inputs[i];
+        [inputs addObject:@{
+            @"name":    in->name ? @(in->name) : @"",
+            @"type":    @((int)in->type),
+            @"dim_v":   @(in->dim_v),
+            @"dim_m":   @(in->dim_m),
+            @"offset":  @((NSInteger)in->offset),
+            @"binding": @(in->binding),
