+/* ----------- Runtime-Instrumentation (ios-metal.52) -----------
+ * Per-draw diagnostic log nach NSCachesDirectory/mpv-renderpass.log.
+ * Append-mode, truncated on first init pro Prozess. Idee: chroma-merge-
+ * pass vs working passes diffen → divergierende runtime-state finden
+ * (FBO-dims, texture-binding-slot-collisions, vertex-data-offsets). */
+static FILE *metal_rp_log_file(void)
+{
+    static dispatch_once_t once;
+    static FILE *fp = NULL;
+    dispatch_once(&once, ^{
+        NSArray *paths = NSSearchPathForDirectoriesInDomains(
+            NSCachesDirectory, NSUserDomainMask, YES);
+        if (paths.count == 0)
+            return;
+        NSString *log_path = [paths.firstObject
+            stringByAppendingPathComponent:@"mpv-renderpass.log"];
+        /* Truncate on launch = nur die aktuelle session interessiert. */
+        fp = fopen(log_path.UTF8String, "w");
+    });
+    return fp;
+}
 
+static void metal_rp_logf(const char *fmt, ...) {
+    FILE *fp = metal_rp_log_file();
+    if (!fp) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(fp, fmt, ap);
+    va_end(ap);
+    fflush(fp);
+}
 
+static void metal_rp_log_hex(const char *label, const void *data, size_t bytes) {
+    FILE *fp = metal_rp_log_file();
+    if (!fp || !data) return;
+    fprintf(fp, "  %s [%zu]:", label, bytes);
+    const uint8_t *b = data;
+    /* Cap at 192B — covers full UBO for largest case (mat3+mat2+mat2 = 112,
+     * vertex_data 6*24 = 144). */
+    size_t cap = bytes > 192 ? 192 : bytes;
+    for (size_t i = 0; i < cap; i++) {
+        if (i % 16 == 0) fprintf(fp, "\n    ");
+        fprintf(fp, "%02x ", b[i]);
+    }
+    fprintf(fp, "\n");
+    fflush(fp);
+}
+
+/* Caller-provides 17-byte buffer to avoid static-buffer races (three
+ * back-to-back inline calls would overwrite each other otherwise). */
+static const char *metal_rp_glsl_hash_buf(const char *glsl, char *out17) {
+    if (!glsl) {
+        strcpy(out17, "<null>");
+        return out17;
+    }
+    unsigned char h[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(glsl, (CC_LONG)strlen(glsl), h);
+    for (int i = 0; i < 8; i++) snprintf(out17 + i*2, 3, "%02x", h[i]);
+    out17[16] = 0;
+    return out17;
+}
