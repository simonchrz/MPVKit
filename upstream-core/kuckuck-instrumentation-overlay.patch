+            p.blend_dst_rgb    = (enum ra_blend)[e[@"blend_dst_rgb"] intValue];
+            p.blend_src_alpha  = (enum ra_blend)[e[@"blend_src_alpha"] intValue];
+            p.blend_dst_alpha  = (enum ra_blend)[e[@"blend_dst_alpha"] intValue];
+            p.push_constants_size = (size_t)[e[@"push_constants_size"] longLongValue];
+            p.vertex_stride       = [e[@"vertex_stride"] intValue];
