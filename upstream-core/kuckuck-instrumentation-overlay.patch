+NSMutableArray *metal_load_pso_sidecar(void)
+{
+    NSString *path = metal_pso_sidecar_path();
+    if (!path) return [NSMutableArray array];
+    NSData *data = [NSData dataWithContentsOfFile:path];
+    if (!data) return [NSMutableArray array];
+    NSError *err = nil;
+    id obj = [NSPropertyListSerialization
+              propertyListWithData:data
+                           options:NSPropertyListMutableContainers
+                            format:nil
+                             error:&err];
+    NSMutableArray *result = nil;
+    if ([obj isKindOfClass:[NSMutableArray class]]) result = obj;
+    else if ([obj isKindOfClass:[NSArray class]]) result = [(NSArray *)obj mutableCopy];
+    if (!result) return [NSMutableArray array];
 
+    /* Sanity-check: prior buggy builds (vor dem CFRetain-Fix in init) konnten
+     * dangling-NSMutableArray-pointer save'n, das schrieb heap-aliased garbage
+     * (z.B. [[float,float,float,float], ...]) raus. Wenn der File nicht aus
+     * NSDictionary-entries besteht, ist er Müll → wegwerfen statt loaden. */
+    for (id e in result) {
+        if (![e isKindOfClass:[NSDictionary class]] || !((NSDictionary *)e)[@"cache_key"]) {
+            [[NSFileManager defaultManager] removeItemAtPath:path error:NULL];
+            return [NSMutableArray array];
+        }
+    }
+    return result;
+}
 
+void metal_save_pso_sidecar(NSArray *entries)
+{
+    if (!entries.count) return;
+    NSString *path = metal_pso_sidecar_path();
+    if (!path) return;
+    NSError *err = nil;
+    NSData *data = [NSPropertyListSerialization
+                    dataWithPropertyList:entries
+                                  format:NSPropertyListBinaryFormat_v1_0
+                                 options:0
+                                   error:&err];
+    if (data) [data writeToFile:path atomically:YES];
