+/* Helper: ra_renderpass_input aus einem serialisiertem NSDictionary
+ * rekonstruieren. Name-Pointer ist talloc-child von ta_ctx, lebt nur
+ * solange ta_ctx existiert. */
+static void metal_deserialize_input(void *ta_ctx, NSDictionary *e,
+                                    struct ra_renderpass_input *out)
+{
+    NSString *name = e[@"name"];
+    out->name    = (name.length > 0) ? talloc_strdup(ta_ctx, name.UTF8String) : NULL;
+    out->type    = (enum ra_vartype)[e[@"type"] intValue];
+    out->dim_v   = [e[@"dim_v"] intValue];
+    out->dim_m   = [e[@"dim_m"] intValue];
+    out->offset  = (size_t)[e[@"offset"] longLongValue];
+    out->binding = [e[@"binding"] intValue];
+}
