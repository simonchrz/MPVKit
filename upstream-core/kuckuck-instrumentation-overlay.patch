+    d[@"blend_src_rgb"]   = @((int)p->blend_src_rgb);
+    d[@"blend_dst_rgb"]   = @((int)p->blend_dst_rgb);
+    d[@"blend_src_alpha"] = @((int)p->blend_src_alpha);
+    d[@"blend_dst_alpha"] = @((int)p->blend_dst_alpha);
+    d[@"push_constants_size"] = @((NSInteger)p->push_constants_size);
+    d[@"vertex_stride"]       = @(p->vertex_stride);
 
