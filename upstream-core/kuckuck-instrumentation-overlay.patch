+static const char *metal_rp_vartype_name(int t) {
+    switch ((enum ra_vartype)t) {
+        case RA_VARTYPE_INVALID: return "INVALID";
+        case RA_VARTYPE_INT:     return "INT";
+        case RA_VARTYPE_FLOAT:   return "FLOAT";
+        case RA_VARTYPE_TEX:     return "TEX";
+        case RA_VARTYPE_IMG_W:   return "IMG_W";
+        case RA_VARTYPE_BYTE_UNORM: return "BYTE_UNORM";
+        case RA_VARTYPE_BUF_RO:  return "BUF_RO";
+        case RA_VARTYPE_BUF_RW:  return "BUF_RW";
+        default: return "?";
+    }
+}
