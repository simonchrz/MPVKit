diff --git a/libavcodec/videotoolbox.c b/libavcodec/videotoolbox.c
index 0000000..0000001 100644
--- a/libavcodec/videotoolbox.c
+++ b/libavcodec/videotoolbox.c
@@ -1065,8 +1065,25 @@ int ff_videotoolbox_common_end_frame(AVCodecContext *avctx, AVFrame *frame)

     status = videotoolbox_session_decode_frame(avctx);
     if (status != noErr) {
-        if (status == kVTVideoDecoderMalfunctionErr || status == kVTInvalidSessionErr)
+        /* iOS-VT-background-death recovery: inline-retry statt mpv die
+         * failure als hwdec-fallback-trigger durchreichen zu lassen. iOS
+         * killt VT-Sessions wenn die App backgrounded, der nächste decode
+         * scheitert mit kVTInvalidSessionErr. Ohne inline-retry markiert
+         * mpv hwdec=videotoolbox als kaputt + schaltet auf SW-decode mit
+         * falscher color-matrix → only loadfile recovers (= 5s schwarz).
+         * Mit inline-retry recreaten wir die VT-Session sofort (~50-100ms)
+         * + decoden den frame erneut, kein User-visible black flash. */
+        if (status == kVTVideoDecoderMalfunctionErr || status == kVTInvalidSessionErr) {
+            av_log(avctx, AV_LOG_VERBOSE, "VideoToolbox decode failure (%s), reconfig inline...\n",
+                   videotoolbox_error_string(status));
+            videotoolbox_stop(avctx);
+            if (videotoolbox_start(avctx) == 0) {
+                status = videotoolbox_session_decode_frame(avctx);
+                if (status == noErr && vtctx->frame)
+                    return videotoolbox_buffer_create(avctx, frame);
+            }
             vtctx->reconfig_needed = true;
+        }
         av_log(avctx, AV_LOG_ERROR, "Failed to decode frame (%s, %d)\n", videotoolbox_error_string(status), (int)status);
         return AVERROR_UNKNOWN;
     }
