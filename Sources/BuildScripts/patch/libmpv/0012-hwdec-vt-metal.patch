diff --git a/video/out/hwdec/hwdec_vt_metal.m b/video/out/hwdec/hwdec_vt_metal.m
new file mode 100644
index 0000000..41b8111
--- /dev/null
+++ b/video/out/hwdec/hwdec_vt_metal.m
@@ -0,0 +1,155 @@
+/*
+ * VideoToolbox hwdec interop für unseren hand-rolled Metal RA backend.
+ * Zero-copy CVPixelBuffer → MTLTexture via CVMetalTextureCache, dann
+ * Wrap als ra_tex via ra_metal_wrap_external_texture(). Pendant zu
+ * hwdec_vt_pl.m (libplacebo/Vulkan) und vt_gl_init (OpenGL/Cocoa);
+ * dieser Pfad wählt Metal direkt ohne libplacebo-Indirektion.
+ *
+ * Eingehängt in hwdec_vt.c's interop_inits[]-Array via vt_metal_init().
+ */
+
+#include <assert.h>
+
+#include <CoreVideo/CoreVideo.h>
+#include <Metal/Metal.h>
+
+#include <libavutil/hwcontext.h>
+
+#include "config.h"
+
+#include "video/out/gpu/hwdec.h"
+#include "video/mp_image_pool.h"
+
+#include "hwdec_vt.h"
+#include "../metal/ra_metal.h"
+
+/* mpv ra_format → MTLPixelFormat. Nur die formats die VideoToolbox für
+ * YUV planes tatsächlich produziert (r8/rg8 für 8-bit 4:2:0, r16/rg16
+ * für 10-bit HDR/Dolby-Vision). Andere formats fallen durch → mapper_map
+ * returnt -1 → mpv fällt auf SW-decode-Pfad zurück. */
+static MTLPixelFormat ra_fmt_to_mtl(const struct ra_format *fmt)
+{
+    if (!fmt || !fmt->name) return MTLPixelFormatInvalid;
+    if (strcmp(fmt->name, "r8") == 0)     return MTLPixelFormatR8Unorm;
+    if (strcmp(fmt->name, "rg8") == 0)    return MTLPixelFormatRG8Unorm;
+    if (strcmp(fmt->name, "rgba8") == 0)  return MTLPixelFormatRGBA8Unorm;
+    if (strcmp(fmt->name, "r16") == 0)    return MTLPixelFormatR16Unorm;
+    if (strcmp(fmt->name, "rg16") == 0)   return MTLPixelFormatRG16Unorm;
+    if (strcmp(fmt->name, "rgba16") == 0) return MTLPixelFormatRGBA16Unorm;
+    return MTLPixelFormatInvalid;
+}
+
+static int mapper_init(struct ra_hwdec_mapper *mapper)
+{
+    struct priv *p = mapper->priv;
+    struct ra_metal *rmp = ra_metal_get(mapper->owner->ra_ctx->ra);
+    if (!rmp || !rmp->device) {
+        MP_ERR(mapper, "vt_metal: ra_metal not available\n");
+        return -1;
+    }
+
+    CVReturn err = CVMetalTextureCacheCreate(
+        kCFAllocatorDefault, NULL, rmp->device, NULL,
+        &p->mtl_texture_cache);
+    if (err != noErr) {
+        MP_ERR(mapper, "vt_metal: CVMetalTextureCacheCreate failed: %d\n",
+               (int)err);
+        return -1;
+    }
+
+    return 0;
+}
+
+static void mapper_unmap(struct ra_hwdec_mapper *mapper)
+{
+    struct priv *p = mapper->priv;
+
+    for (int i = 0; i < p->desc.num_planes; i++) {
+        ra_tex_free(mapper->ra, &mapper->tex[i]);
+        if (p->mtl_planes[i]) {
+            CFRelease(p->mtl_planes[i]);
+            p->mtl_planes[i] = NULL;
+        }
+    }
+
+    if (p->mtl_texture_cache)
+        CVMetalTextureCacheFlush(p->mtl_texture_cache, 0);
+}
+
+static void mapper_uninit(struct ra_hwdec_mapper *mapper)
+{
+    struct priv *p = mapper->priv;
+    if (p->mtl_texture_cache) {
+        CFRelease(p->mtl_texture_cache);
+        p->mtl_texture_cache = NULL;
+    }
+}
+
+static int mapper_map(struct ra_hwdec_mapper *mapper)
+{
+    struct priv *p = mapper->priv;
+
+    CVPixelBufferRelease(p->pbuf);
+    p->pbuf = (CVPixelBufferRef)mapper->src->planes[3];
+    CVPixelBufferRetain(p->pbuf);
+
+    const bool planar = CVPixelBufferIsPlanar(p->pbuf);
+    const int planes  = CVPixelBufferGetPlaneCount(p->pbuf);
+    mp_assert((planar && planes == p->desc.num_planes)
+              || p->desc.num_planes == 1);
+
+    for (int i = 0; i < p->desc.num_planes; i++) {
+        const struct ra_format *fmt = p->desc.planes[i];
+        MTLPixelFormat mtlfmt = ra_fmt_to_mtl(fmt);
+        if (mtlfmt == MTLPixelFormatInvalid) {
+            MP_ERR(mapper, "vt_metal: format unsupported for plane %d: %s\n",
+                   i, fmt && fmt->name ? fmt->name : "?");
+            return -1;
+        }
+
+        size_t width  = CVPixelBufferGetWidthOfPlane(p->pbuf, i);
+        size_t height = CVPixelBufferGetHeightOfPlane(p->pbuf, i);
+
+        CVReturn err = CVMetalTextureCacheCreateTextureFromImage(
+            kCFAllocatorDefault, p->mtl_texture_cache, p->pbuf, NULL,
+            mtlfmt, width, height, i, &p->mtl_planes[i]);
+        if (err != noErr) {
+            MP_ERR(mapper, "vt_metal: TextureCacheCreateFromImage failed "
+                   "for plane %d: %d\n", i, (int)err);
+            return -1;
+        }
+
+        id<MTLTexture> mtl_tex = CVMetalTextureGetTexture(p->mtl_planes[i]);
+        mapper->tex[i] = ra_metal_wrap_external_texture(
+            mapper->owner->ra_ctx, mtl_tex, fmt, (int)width, (int)height);
+        if (!mapper->tex[i]) {
+            MP_ERR(mapper, "vt_metal: ra_metal_wrap_external_texture failed "
+                   "for plane %d\n", i);
+            return -1;
+        }
+    }
+
+    return 0;
+}
+
+bool vt_metal_init(const struct ra_hwdec *hw)
+{
+    struct priv_owner *p = hw->priv;
+
+    /* Nur greifen wenn ra unser Metal RA backend ist. ra_metal_get casts
+     * ra->priv blind; check über ra->fns wäre sauberer aber dafür müsste
+     * ra_fns_metal hier sichtbar sein (= würde Header-Include-Zyklus
+     * erzeugen). Stattdessen verlassen wir uns auf das Verhalten dass
+     * nur unsere init.m's ra_init_metal das Backend setzt. */
+    struct ra_metal *rmp = ra_metal_get(hw->ra_ctx->ra);
+    if (!rmp) {
+        return false;
+    }
+
+    p->interop_init   = mapper_init;
+    p->interop_uninit = mapper_uninit;
+    p->interop_map    = mapper_map;
+    p->interop_unmap  = mapper_unmap;
+
+    return true;
+}
