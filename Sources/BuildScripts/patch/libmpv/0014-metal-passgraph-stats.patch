+/* ---------------------------------------------------------------------
+ * Renderpass-Graph-Statistics
+ * Process-globale atomic-Counter, inkrementiert von metal_renderpass_run
+ * (ra_metal_renderpass.m) pro ausgeführtem Pass. Single-writer (VO-Render-
+ * Thread), Multi-reader (App-Snapshot von beliebigem Thread) → atomic.
+ * --------------------------------------------------------------------- */
+_Atomic int64_t mpv_metal_pg_total       = 0;
+_Atomic int64_t mpv_metal_pg_raster      = 0;
+_Atomic int64_t mpv_metal_pg_compute     = 0;
+_Atomic int64_t mpv_metal_pg_same_target = 0;
+
+void mpv_metal_passgraph_stats_get(mpv_metal_passgraph_stats *out)
+{
+    if (!out) return;
+    out->total_passes      = atomic_load(&mpv_metal_pg_total);
+    out->raster_passes     = atomic_load(&mpv_metal_pg_raster);
+    out->compute_passes    = atomic_load(&mpv_metal_pg_compute);
+    out->same_target_pairs = atomic_load(&mpv_metal_pg_same_target);
+}
