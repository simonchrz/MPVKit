+/**
+ * Pass-Graph-Statistics für die Tile-Shading-Feasibility-Analyse
+ * (Phase-1 des scaler-chain-merge-refactors). Pro frame zählen wir
+ * wieviele render-passes mpv emittiert + wieviele davon „same-target-
+ * adjacent" sind (= consecutive raster-passes mit identischem
+ * colorAttachments[0].texture, das sind unter Metal-tile-shading
+ * direkte Merge-Kandidaten weil das output im tile-memory bleiben kann).
+ *
+ * Verhältnis (same_target_pairs / max(1, raster_passes-frames)) =
+ * grobe Obergrenze für den Tile-Shading-Win in unserer Workload-Mix.
+ * Wenn das über workload <20% liegt → abort, scaler-chain-merge ist
+ * nicht load-bearing. ≥50% → continue zu Phase 2.
+ */
+typedef struct mpv_metal_passgraph_stats {
+    int64_t total_passes;       /* alle metal_renderpass_run-Aufrufe */
+    int64_t raster_passes;
+    int64_t compute_passes;
+    /* Anzahl adjacent (N, N+1) wo beide raster sind und identisches
+     * target haben. Akkumuliert über alle commits = workload-Mittel. */
+    int64_t same_target_pairs;
+    int64_t frames;             /* ra_metal_commit_frame-Aufrufe */
+} mpv_metal_passgraph_stats;
+
+/**
+ * Snapshot der pass-graph-Counter. Threadsafe via atomic-loads.
+ */
+void mpv_metal_passgraph_stats_get(mpv_metal_passgraph_stats *out);
+
 #ifdef __cplusplus
 }
 #endif
