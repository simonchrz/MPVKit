+/* Shader-dump (ios-metal.50): writes generated GLSL+MSL pairs to
+ * NSCachesDirectory/mpv-shaders/<hash>-<stage>.{glsl,msl} hash-deduped.
+ * Pullbar via devicectl für diff-Analyse zwischen broken-stream (raw-TS
+ * 3-plane yuv420p) und working-stream (HLS nv12) shader-Sets. */
+static void metal_dump_shader_pair(const char *glsl,
+                                   const char *msl,
+                                   enum glsl_shader stage_type)
+{
+    if (!glsl || !msl)
+        return;
+    static dispatch_once_t once;
+    static NSString *dump_dir;
+    dispatch_once(&once, ^{
+        NSArray *paths = NSSearchPathForDirectoriesInDomains(
+            NSCachesDirectory, NSUserDomainMask, YES);
+        if (paths.count == 0)
+            return;
+        /* Retain damit der static-pointer nach dispatch_once's
+         * autorelease-pool-drain noch valid bleibt. Sonst dangling
+         * pointer + SEGFAULT auf nächstem Zugriff (crash in .50). */
+        dump_dir = [[paths.firstObject stringByAppendingPathComponent:@"mpv-shaders"] retain];
+        [[NSFileManager defaultManager] createDirectoryAtPath:dump_dir
+                                  withIntermediateDirectories:YES
+                                                   attributes:nil
+                                                        error:nil];
+    });
+    if (!dump_dir)
+        return;
+    unsigned char hash[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(glsl, (CC_LONG)strlen(glsl), hash);
+    char hexbuf[17];
+    for (int i = 0; i < 8; i++)
+        snprintf(hexbuf + i * 2, 3, "%02x", hash[i]);
+    hexbuf[16] = 0;
+    const char *stage_name =
+        (stage_type == GLSL_SHADER_VERTEX)   ? "vert" :
+        (stage_type == GLSL_SHADER_FRAGMENT) ? "frag" : "comp";
+    NSString *glsl_path = [dump_dir stringByAppendingPathComponent:
+        [NSString stringWithFormat:@"%s-%s.glsl", hexbuf, stage_name]];
+    NSString *msl_path = [dump_dir stringByAppendingPathComponent:
+        [NSString stringWithFormat:@"%s-%s.msl", hexbuf, stage_name]];
+    NSFileManager *fm = [NSFileManager defaultManager];
+    if (![fm fileExistsAtPath:glsl_path]) {
+        [[NSString stringWithUTF8String:glsl] writeToFile:glsl_path
+                                               atomically:YES
+                                                 encoding:NSUTF8StringEncoding
+                                                    error:nil];
+    }
+    if (![fm fileExistsAtPath:msl_path]) {
+        [[NSString stringWithUTF8String:msl] writeToFile:msl_path
+                                              atomically:YES
+                                                encoding:NSUTF8StringEncoding
+                                                   error:nil];
+    }
+}
 
