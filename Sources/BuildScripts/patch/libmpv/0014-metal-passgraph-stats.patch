+/**
+ * Renderpass-Graph-Statistics für externe Diagnostik. Counter werden
+ * atomic vom Metal-RA-Backend in metal_renderpass_run inkrementiert,
+ * pro ausgeführtem Pass. Anwendungsfall: messen wie viele der pro Frame
+ * dispatchten Passes über den Compute- vs Raster-Pfad laufen, und wie
+ * viele aufeinanderfolgende Raster-Passes dasselbe Render-Target treffen
+ * (= Merge-Kandidaten, die Load/Store-Bandbreite auf intermediate FBOs
+ * sparen würden). Siehe RA_CAP_PARALLEL_COMPUTE / Chroma-Merge-Pfad.
+ */
+typedef struct mpv_metal_passgraph_stats {
+    /* Total Anzahl ausgeführter renderpass_run-Calls (raster + compute). */
+    int64_t total_passes;
+    /* Davon über den Raster-(Fragment-)Pfad (renderCommandEncoder). */
+    int64_t raster_passes;
+    /* Davon über den Compute-Pfad (computeCommandEncoder). */
+    int64_t compute_passes;
+    /* Anzahl Raster-Passes deren Target == Target des direkt vorhergehenden
+     * Raster-Passes ist (consecutive same-FBO = potenziell mergebar). */
+    int64_t same_target_pairs;
+} mpv_metal_passgraph_stats;
+
+/**
+ * Snapshot der aktuellen Renderpass-Graph-Stats. Threadsafe via
+ * atomic-loads. `out` darf nicht NULL sein.
+ */
+void mpv_metal_passgraph_stats_get(mpv_metal_passgraph_stats *out);
+
