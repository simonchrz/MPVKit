+/* mpv-iOS: trigger VOCTRL_EXTERNAL_RESIZE so vo_gpu_next re-reads the
+ * CAMetalLayer's drawableSize, recreates the Vulkan swapchain via our patched
+ * moltenvk_reconfig (which updates vo->dwidth/dheight), and recomputes the
+ * video display rect via resize(vo). */
+static void cmd_ios_surface_resize(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    if (mpctx->video_out)
+        vo_control(mpctx->video_out, VOCTRL_EXTERNAL_RESIZE, NULL);
+}
+
 /* This array defines all known commands.
  * The first field the command name used in libmpv and input.conf.
  * The second field is the handler function (see mp_cmd_def.handler and
@@ -7640,5 +7652,13 @@
     { "notify-property", cmd_notify_property, { {"property", OPT_STRING(v.s)} } },
 
+    /* mpv-iOS: zero-arg command that triggers vo_control(VOCTRL_EXTERNAL_RESIZE),
+     * the same dispatch path as android-surface-size update on Android.
+     * Used by the iOS Swift wrapper after CAMetalLayer.frame changes since
+     * CALayer KVO is documented as unreliable and the option-property
+     * auto-promotion path returns M_PROPERTY_UNKNOWN for android-surface-size
+     * on iOS even when the option is registered. */
+    { "ios-surface-resize", cmd_ios_surface_resize },
