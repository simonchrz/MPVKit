+        // Kuckuck: a hwdec session can die *recoverably* — iOS invalidates the
+        // VideoToolbox session when the app backgrounds, a macOS GPU reset, etc.
+        // The decode then fails for the handful of in-flight frames at once,
+        // tripping the software-fallback threshold even though the hwdec would
+        // work again immediately. Before permanently descending the hwdec list
+        // to software (desaturated SW decode that only a full reload recovers),
+        // re-init the SAME hwdec once: reinit() rebuilds the decode session in
+        // place and sets wait_for_keyframe to guard against an immediate
+        // re-fallback. hwdec_recover_count is reset on the next good frame, so
+        // every distinct session-loss event gets one fresh attempt, while a
+        // genuinely broken hwdec still descends to software on the next failure.
+        if (ctx->use_hwdec && ctx->hwdec_recover_count < 1) {
+            ctx->hwdec_recover_count += 1;
+            MP_WARN(vd, "Hardware decoding failed; re-initializing hwdec before "
+                        "software fallback (recovery attempt %d).\n",
+                        ctx->hwdec_recover_count);
+            reinit(vd);
+            ctx->requeue_packets = pkts;
+            ctx->num_requeue_packets = num_pkts;
+            return 0; // retry on the freshly re-inited decoder
+        }
+
