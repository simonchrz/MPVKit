+/* Clear den prozess-globalen Sync-Flush-Pointer wenn er auf GENAU dieses
+ * Sidecar-Array zeigt. Aufgerufen aus ra_metal_destroy_fns BEVOR das Array
+ * freigegeben wird → mpv_metal_pso_sidecar_flush() dereft danach nie mehr
+ * freed memory (UAF, Crashreport 235468D2). CAS statt blindem store damit
+ * ein parallel anderer aktiver Player den Global nicht fälschlich nullt. */
+void metal_clear_pso_sidecar_if(void *sidecar_bridge)
+{
+    if (!sidecar_bridge) return;
+    uintptr_t expected = (uintptr_t)sidecar_bridge;
+    atomic_compare_exchange_strong(&g_active_pso_sidecar, &expected, 0);
+}
