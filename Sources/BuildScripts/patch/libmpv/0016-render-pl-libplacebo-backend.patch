+    // MPV_RENDER_PL=1 and otherwise returns NOT_IMPLEMENTED, so the proven
+    // ra_metal path (render_backend_gpu) handles Metal by default.
+    &render_backend_pl,
+#endif
     &render_backend_gpu,
     &render_backend_sw,
     NULL
