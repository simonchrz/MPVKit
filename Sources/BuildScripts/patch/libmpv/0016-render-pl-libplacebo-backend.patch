+#include <CoreVideo/CoreVideo.h>
+
+#include <libplacebo/renderer.h>
+#include <libplacebo/metal.h>
+#include <libplacebo/swapchain.h>
+#include <libplacebo/cache.h>
+#include <libplacebo/shaders/custom.h>
+#include <libplacebo/shaders/deinterlacing.h>
+#include <libplacebo/dither.h>
+#include <libplacebo/utils/frame_queue.h>
+
+#include <stdio.h>
+#include <limits.h>
+#include <time.h>
+
+#define PL_LIBAV_IMPLEMENTATION 1
+#include <libplacebo/utils/libav.h>
+
+#include <libavutil/frame.h>
+
+#include "mpv/render.h"
+#include "mpv/render_mtl.h"
+
+// OSD/subtitle overlay caching, mirrors vo_gpu_next: one cached pl_tex per
+// render_index (MAX_OSD_PARTS), reused across frames; the per-part rects are
+// rebuilt each frame into entry->parts and pointed at by an entry in overlays[].
+struct osd_entry {
+    pl_tex tex;
+    struct pl_overlay_part *parts;   // talloc child of priv
+    int num_parts;
+};
+
+struct osd_cache {
+    struct osd_entry entries[MAX_OSD_PARTS];
+    struct pl_overlay overlays[MAX_OSD_PARTS];
+};
+
+struct priv {
+    pl_log pllog;
+    pl_metal metal;          // owns the MTLDevice/queue wrapper
+    pl_gpu gpu;              // == metal->gpu
+    pl_renderer rr;
+    pl_cache cache;          // persisted GLSL->MSL transpile cache (disk-backed)
+
+    struct mp_image_params img_params;
+    struct mp_rect src, dst;
+    struct mp_osd_res osd;
+
+    // OSD/subtitle compositing. osd_state is vo->osd (borrowed, set in
+    // update_external); osd_render() is called per frame at the current pts and
+    // the resulting bitmaps are uploaded as pl_overlay on the target frame.
+    struct osd_state *osd_state;
+    pl_fmt osd_fmt[SUBBITMAP_COUNT];     // r8 (libass A8) / bgra8
+    pl_tex *sub_tex;                     // recycle pool for OSD textures
+    int num_sub_tex;
+    struct osd_cache osd_cache;
+
+    // Frame queue: handles display-time frame selection, deduplication and
+    // (when mpv delivers neighbouring frames) interpolation. Owns the per-frame
+    // plane textures and maps lazily via map_frame_pl.
+    pl_queue queue;
+    uint64_t last_id;        // highest frame_id pushed (skip already-queued)
+    bool want_reset;         // set by reset() (seek); drains the queue next render
+
+    // Optionaler User-Shader (z.B. Anime4K) aus env KUCKUCK_GLSL_SHADER (Datei-
+    // pfad, ein konkatenierter mpv-User-Shader). NULL = kein Hook. rparams =
+    // pl_render_high_quality_params (+ optional der Hook), gemeinsam für Render
+    // und Queue-Radius genutzt.
+    const struct pl_hook *user_hook;
+    char *user_shader_path;  // zuletzt geladener KUCKUCK_GLSL_SHADER-Pfad (strcmp-Cache)
+    bool deint;              // GPU-Deinterlacing an (env KUCKUCK_DEINTERLACE, raw-TS Live-TV)
+    char *deint_algo;        // zuletzt geparster Deinterlace-Algo (strcmp-Cache)
+    struct pl_deinterlace_params deint_params;  // lokale Kopie (algo/skip wählbar via env)
+    char *deband_mode;       // zuletzt angewandter KUCKUCK_DEBAND-Modus (strcmp-Cache)
+    struct pl_color_adjustment color_adj;  // Helligkeits-Nudge (env KUCKUCK_SDR_GAMMA)
+    struct pl_render_params rparams;
+
+    // Zero-Copy-hwdec (J): VT-Device für vd_lavc (hwdec=videotoolbox ohne
+    // -copy). Die Frames (IMGFMT_VIDEOTOOLBOX) wrappen wir in map_frame_pl
+    // via IOSurface direkt als pl_frame — keine CPU-Kopie, kein Upload.
+    struct mp_hwdec_ctx vt_hwdev;
+    bool vt_hwdev_added;
+};
+
+// Per-source-frame state carried through the pl_queue map/unmap/discard
+// callbacks. frame_data points at one of these.
+#define KUCKUCK_FR_MAGIC 0x4B564653u  // 'KVFS' — validiert pl_frame.user_data
+
+struct frame_ref {
+    uint32_t magic;          // KUCKUCK_FR_MAGIC (user_data-Validierung im Mix)
+    struct priv *p;          // for the current source crop (p->src)
+    struct mp_image *mpi;    // +1 ref, freed on unmap/discard
+    AVFrame *av;             // alias of mpi's buffers, valid map..unmap
+    void *vt_pixbuf;         // VT-SR: +1-retained CVPixelBufferRef (dst), bis unmap
+    void *vt_src_pixbuf;     // VT-SR: +1-retained QUELL-Buffer (Motion-Interp)
+    pl_tex vt_tex[2];        // VT-SR: gewrappte IOSurface-Planes (luma/chroma)
+};
+
+// ---- VT-Super-Resolution (Apple ML-Upscaler via App-Bridge) ----------------
+// App-seitig implementiert (Kuckuck VTSuperResBridge.swift, @_cdecl); libmpv
+// referenziert die Symbole nur — sie lösen beim statischen App-Link auf.
+// upscale: 0 = Erfolg (out_pixbuf = +1-retained CVPixelBufferRef, out_iosurface
+// geborgt daraus, out_w/h = Ziel-Dimensionen); <0 = aus/nicht bereit/Fehler →
+// Normalpfad. release: gibt das CVPixelBuffer aus upscale wieder frei.
+extern int  kuckuck_vt_upscale(const uint8_t *y, int y_stride,
+                               const uint8_t *u, int u_stride,
+                               const uint8_t *v, int v_stride,
+                               int w, int h,
+                               void **out_pixbuf, void **out_iosurface,
+                               int *out_w, int *out_h,
+                               void **out_src_pixbuf);
+extern void kuckuck_vt_release(void *pixbuf);
+// Motion-Interp (50→60): Zwischenbild bei `phase` zwischen den zwei von
+// upscale geborgten Quell-Buffern, anschließend 2x-SR. Kontrakt wie upscale.
+extern int  kuckuck_vt_interp_sr(void *prev_src, void *cur_src, float phase,
+                                 void **out_pixbuf, void **out_iosurface,
+                                 int *out_w, int *out_h);
+// Zero-Copy-Variante: Decoder-CVPixelBuffer (hwdec=videotoolbox, planes[3])
+// direkt an die Bridge — Direct-Pass bei session-kompatiblen Dims, sonst
+// croppt/kopiert sie selbst (gelockter Buffer). Kontrakt wie upscale, aber
+// ohne src-Borrow (Motion-Interp läuft nur auf dem CPU-Tuner-Pfad).
+extern int  kuckuck_vt_upscale_pixbuf(void *cv_pixbuf,
+                                      void **out_pixbuf, void **out_iosurface,
+                                      int *out_w, int *out_h);
+
+// Zero-Copy-hwdec (J): IMGFMT_VIDEOTOOLBOX-Frames (hwdec=videotoolbox ohne
+// -copy) tragen den CVPixelBuffer des Decoders in planes[3]. Dessen IOSurface-
+// Planes wrappen wir direkt als pl_frame — keine CPU-Kopie, kein GPU-Upload.
+// NV12 (8-bit → r8/rg8) + P010 (10-bit MSB-aligned → r16/rg16, bit_shift 6,
+// wie libplacebos eigene Vulkan-Zuordnung). Lebensdauer: fr->mpi hält den
+// AVFrame/CVPixelBuffer bis unmap; die Command-Buffer retainen Textur +
+// IOSurface (Use-Count) bis zum GPU-Abschluss, der Decoder-Pool recycelt
+// in-use-Surfaces nicht.
+static bool vt_wrap_map(pl_gpu gpu, struct frame_ref *fr, struct pl_frame *frame)
+{
+    struct mp_image *mpi = fr->mpi;
+    if (mpi->imgfmt != IMGFMT_VIDEOTOOLBOX)
+        return false;
+    CVPixelBufferRef pbuf = (CVPixelBufferRef) mpi->planes[3];
+    IOSurfaceRef surf = pbuf ? CVPixelBufferGetIOSurface(pbuf) : NULL;
+    if (!surf)
+        return false;
+
+    OSType pf = CVPixelBufferGetPixelFormatType(pbuf);
+    const char *lname, *cname;
+    struct pl_bit_encoding bits;
+    switch (pf) {
+    case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        lname = "r8"; cname = "rg8";
+        bits = (struct pl_bit_encoding) { .sample_depth = 8, .color_depth = 8 };
+        break;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        lname = "r16"; cname = "rg16";
+        bits = (struct pl_bit_encoding) { .sample_depth = 16, .color_depth = 10,
+                                          .bit_shift = 6 };
+        break;
+    default:
+        return false;   // unbekanntes CV-Pixelformat → Normalpfad (Download)
+    }
+
+    int w  = (int) CVPixelBufferGetWidthOfPlane(pbuf, 0);
+    int h  = (int) CVPixelBufferGetHeightOfPlane(pbuf, 0);
+    int cw = (int) CVPixelBufferGetWidthOfPlane(pbuf, 1);
+    int ch = (int) CVPixelBufferGetHeightOfPlane(pbuf, 1);
+    pl_fmt fl = pl_find_named_fmt(gpu, lname);
+    pl_fmt fc = pl_find_named_fmt(gpu, cname);
+    pl_tex luma   = fl ? pl_metal_wrap_iosurface(fr->p->metal, surf, 0, w, h, fl) : NULL;
+    pl_tex chroma = fc ? pl_metal_wrap_iosurface(fr->p->metal, surf, 1, cw, ch, fc) : NULL;
+    if (!luma || !chroma) {
+        pl_tex_destroy(gpu, &luma);
+        pl_tex_destroy(gpu, &chroma);
+        return false;
+    }
+
+    *frame = (struct pl_frame) {
+        .num_planes = 2,
+        .planes = {
+            { .texture = luma, .components = 1,
+              .component_mapping = { PL_CHANNEL_Y, PL_CHANNEL_NONE,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+            { .texture = chroma, .components = 2,
+              .component_mapping = { PL_CHANNEL_CB, PL_CHANNEL_CR,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+        },
+        .repr = mpi->params.repr,
+        .color = mpi->params.color,
+    };
+    frame->repr.bits = bits;
+    pl_frame_set_chroma_location(frame, mpi->params.chroma_location);
+
+    struct mp_rect s = fr->p->src;
+    frame->crop = (struct pl_rect2df) { .x0 = s.x0, .y0 = s.y0,
+                                        .x1 = s.x1, .y1 = s.y1 };
+    // vt_pixbuf bleibt NULL: der Buffer gehört dem Decoder (via mpi/AVFrame),
+    // unmap zerstört nur die gewrappten Texturen.
+    fr->vt_tex[0] = luma;
+    fr->vt_tex[1] = chroma;
+    return true;
+}
+
+// Versucht den VT-SR-Pfad: SD-Frame (NV12/420P, 8-bit) via Apple-Super-
+// Resolution 2x hochskalieren, Ergebnis-IOSurface-Planes direkt als pl_frame
+// wrappen (kein GPU-Upload des Originals, keine CPU-Kopie des Ergebnisses).
+// Läuft 1x pro Quellframe (pl_queue-map, nicht pro vsync). Nur wenn die App es
+// via env KUCKUCK_VT_SR=1 freigibt (Content-Gate analog User-Shader; App setzt
+// es nur für SDR-SD-Realfilm). false = Normalpfad (pl_map_avframe_ex).
+static bool vt_sr_try_map(pl_gpu gpu, struct frame_ref *fr, struct pl_frame *frame)
+{
+    const char *env = getenv("KUCKUCK_VT_SR");
+    if (!env || strcmp(env, "1") != 0)
+        return false;
+    struct mp_image *mpi = fr->mpi;
+    if (fr->p->deint)
+        return false;            // GPU-Deint braucht Felder — nicht kombinierbar
+    int w = mpi->w, h = mpi->h;
+    if (w < 96 || h < 96 || w > 1280 || h > 1280)
+        return false;            // VT-SR-Input-Limits (A19: 96..1280)
+
+    void *pixbuf = NULL, *iosurf = NULL, *src_pixbuf = NULL;
+    int ow = 0, oh = 0;
+    if (mpi->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+        // Zero-Copy-hwdec: Decoder-CVPixelBuffer direkt an die Bridge.
+        // Nur 8-bit NV12 — P010/HDR ist kein SR-Kandidat (vt_wrap_map
+        // übernimmt nach unserem false).
+        CVPixelBufferRef pbuf = (CVPixelBufferRef) mpi->planes[3];
+        OSType pf = pbuf ? CVPixelBufferGetPixelFormatType(pbuf) : 0;
+        if (pf != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange &&
+            pf != kCVPixelFormatType_420YpCbCr8BiPlanarFullRange)
+            return false;
+        if (kuckuck_vt_upscale_pixbuf(pbuf, &pixbuf, &iosurf, &ow, &oh) != 0)
+            return false;
+    } else {
+        bool nv12 = mpi->imgfmt == IMGFMT_NV12;
+        if (!nv12 && mpi->imgfmt != IMGFMT_420P)
+            return false;
+        if (kuckuck_vt_upscale(mpi->planes[0], (int) mpi->stride[0],
+                               mpi->planes[1], (int) mpi->stride[1],
+                               nv12 ? NULL : mpi->planes[2],
+                               nv12 ? 0 : (int) mpi->stride[2],
+                               w, h, &pixbuf, &iosurf, &ow, &oh,
+                               &src_pixbuf) != 0)
+            return false;
+    }
+
+    pl_fmt fmt_l = pl_find_named_fmt(gpu, "r8");
+    pl_fmt fmt_c = pl_find_named_fmt(gpu, "rg8");
+    pl_tex luma   = fmt_l ? pl_metal_wrap_iosurface(fr->p->metal, iosurf, 0, ow, oh, fmt_l) : NULL;
+    pl_tex chroma = fmt_c ? pl_metal_wrap_iosurface(fr->p->metal, iosurf, 1, ow / 2, oh / 2, fmt_c) : NULL;
+    if (!luma || !chroma) {
+        pl_tex_destroy(gpu, &luma);
+        pl_tex_destroy(gpu, &chroma);
+        kuckuck_vt_release(pixbuf);
+        if (src_pixbuf)
+            kuckuck_vt_release(src_pixbuf);
+        return false;
+    }
+
+    *frame = (struct pl_frame) {
+        .num_planes = 2,
+        .planes = {
+            { .texture = luma, .components = 1,
+              .component_mapping = { PL_CHANNEL_Y, PL_CHANNEL_NONE,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+            { .texture = chroma, .components = 2,
+              .component_mapping = { PL_CHANNEL_CB, PL_CHANNEL_CR,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+        },
+        .repr = mpi->params.repr,
+        .color = mpi->params.color,
+    };
+    // Der Scaler liefert immer 8-bit 4:2:0, unabhängig von der Quell-Codierung.
+    frame->repr.bits = (struct pl_bit_encoding) { .sample_depth = 8, .color_depth = 8 };
+    pl_frame_set_chroma_location(frame, mpi->params.chroma_location);
+
+    // Quell-Crop (panscan/zoom) mit dem Upscale-Faktor mitskalieren.
+    double fx = (double) ow / w, fy = (double) oh / h;
+    struct mp_rect s = fr->p->src;
+    frame->crop = (struct pl_rect2df) { .x0 = s.x0 * fx, .y0 = s.y0 * fy,
+                                        .x1 = s.x1 * fx, .y1 = s.y1 * fy };
+    fr->vt_pixbuf = pixbuf;
+    fr->vt_src_pixbuf = src_pixbuf;
+    fr->vt_tex[0] = luma;
+    fr->vt_tex[1] = chroma;
+    // user_data -> frame_ref: der Motion-Interp-Branch im Mix findet darueber
+    // die Quell-Buffer beider Nachbar-Frames (Magic validiert gegen Frames aus
+    // pl_map_avframe, deren user_data pl-intern belegt ist).
+    frame->user_data = fr;
+    return true;
+}
+
+// pl_queue map: mp_image -> AVFrame -> pl_frame, uploading into the queue-owned
+// plane textures. Applies mpv's source crop (panscan/zoom). On failure the
+// queue neither retries nor calls discard, so free our state here.
+static bool map_frame_pl(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src,
+                         struct pl_frame *frame)
+{
+    struct frame_ref *fr = src->frame_data;
+    // Reihenfolge: vt_sr ZUERST — vt_wrap_map nimmt sonst jeden VT-Frame
+    // (Zero-Copy-Render ohne SR). vt_sr_try_map returnt für Nicht-Kandidaten
+    // (env aus, HD, 10-bit, Session lädt noch) false → vt_wrap als Fallback.
+    if (vt_sr_try_map(gpu, fr, frame))
+        return true;
+    if (vt_wrap_map(gpu, fr, frame))
+        return true;
+    fr->av = mp_image_to_av_frame(fr->mpi);
+    if (!fr->av) {
+        talloc_free(fr->mpi);
+        talloc_free(fr);
+        return false;
+    }
+    if (!pl_map_avframe_ex(gpu, frame, &(struct pl_avframe_params) {
+            .frame = fr->av, .tex = tex }))
+    {
+        av_frame_free(&fr->av);
+        talloc_free(fr->mpi);
+        talloc_free(fr);
+        return false;
+    }
+    struct mp_rect s = fr->p->src;
+    frame->crop = (struct pl_rect2df) { .x0 = s.x0, .y0 = s.y0, .x1 = s.x1, .y1 = s.y1 };
+    // Deinterlace erzwingen (raw-TS-Frames sind oft NICHT als interlaced
+    // geflaggt): jeden Frame als Top-Field-First markieren → pl_queue/Renderer
+    // deinterlacen (BWDIF). prev/next verwaltet die pl_queue.
+    if (fr->p->deint) {
+        frame->field = PL_FIELD_TOP;
+        frame->first_field = PL_FIELD_TOP;
+    }
+    return true;
+}
+
+static void unmap_frame_pl(pl_gpu gpu, struct pl_frame *frame,
+                           const struct pl_source_frame *src)
+{
+    struct frame_ref *fr = src->frame_data;
+    if (fr->vt_tex[0]) {
+        // IOSurface-Wrap-Pfade (Zero-Copy-hwdec / VT-SR): gewrappte Texturen
+        // zerstören; beim VT-SR-Pfad zusätzlich den dst-Buffer an die App-
+        // Bridge zurückgeben (Pool-Recycling erst ab hier erlaubt). Beim
+        // Zero-Copy-Pfad gehört der Buffer dem Decoder (via mpi, unten).
+        pl_tex_destroy(gpu, &fr->vt_tex[0]);
+        pl_tex_destroy(gpu, &fr->vt_tex[1]);
+        if (fr->vt_pixbuf)
+            kuckuck_vt_release(fr->vt_pixbuf);
+        if (fr->vt_src_pixbuf)
+            kuckuck_vt_release(fr->vt_src_pixbuf);
+    } else {
+        pl_unmap_avframe(gpu, frame);
+    }
+    if (fr->av)
+        av_frame_free(&fr->av);
+    talloc_free(fr->mpi);
+    talloc_free(fr);
+}
+
+static void discard_frame_pl(const struct pl_source_frame *src)
+{
+    struct frame_ref *fr = src->frame_data;
+    talloc_free(fr->mpi);
+    talloc_free(fr);
+}
+
+// Disk path for the shader cache: the app sandbox's Library/Caches (purgeable
+// by iOS under pressure, persistent across launches otherwise). Returns false
+// if HOME is unset or the path doesn't fit.
+static bool pl_cache_file_path(char *buf, size_t size)
+{
+    const char *home = getenv("HOME");
+    if (!home)
+        return false;
+    int n = snprintf(buf, size, "%s/Library/Caches/render_pl_msl.cache", home);
+    return n > 0 && (size_t) n < size;
+}
+
+// Lädt/wechselt den optionalen User-Shader (Anime4K/RAVU) aus env
+// KUCKUCK_GLSL_SHADER. Aufgerufen in pl_init UND pro Frame in pl_render: die App
+// setzt das env pro Video (Content-Gate: Cartoon→Anime4K, Realfilm→RAVU, HD→aus)
+// und der Render-Thread hot-swapt den pl_hook, sobald sich der Pfad ändert.
+// strcmp-Guard → fopen/parse nur bei echtem Wechsel, nicht jeden Frame. Leeres/
+// fehlendes env = kein Hook (Upscaler aus). Braucht p->gpu (in pl_init gesetzt).
+// Core: shared by the mpv render path (pl_apply_user_shader) and the hybrid
+// path (kuckuck_hybrid_render). Mutates rparams->hooks + the caller's
+// user_hook/shader_path fields, allocating talloc children of tactx. user_hook
+// MUST be a stable address (a field in the owning struct): rparams->hooks is
+// set to point at it.
+static void kk_apply_user_shader(void *tactx, pl_gpu gpu,
+                                 struct pl_render_params *rparams,
+                                 const struct pl_hook **user_hook,
+                                 char **shader_path)
+{
+    const char *path = getenv("KUCKUCK_GLSL_SHADER");
+    if (!path)
+        path = "";
+    const char *cur = *shader_path ? *shader_path : "";
+    if (strcmp(path, cur) == 0)
+        return;  // unverändert → nichts tun (kein fopen pro Frame)
+
+    // Pfad gewechselt → alten Hook weg, neuen laden (oder keinen).
+    if (*user_hook)
+        pl_mpv_user_shader_destroy(user_hook);
+    rparams->hooks = NULL;
+    rparams->num_hooks = 0;
+    talloc_free(*shader_path);
+    *shader_path = talloc_strdup(tactx, path);
+
+    if (!path[0])
+        return;  // env geleert → Upscaler aus
+
+    FILE *sf = fopen(path, "rb");
+    if (!sf)
+        return;
+    fseek(sf, 0, SEEK_END);
+    long ssz = ftell(sf);
+    fseek(sf, 0, SEEK_SET);
+    if (ssz > 0 && ssz < 8 * 1024 * 1024) {
+        char *sbuf = talloc_size(tactx, ssz + 1);
+        size_t srd = fread(sbuf, 1, ssz, sf);
+        sbuf[srd] = 0;
+        *user_hook = pl_mpv_user_shader_parse(gpu, sbuf, srd);
+        talloc_free(sbuf);
+    }
+    fclose(sf);
+    if (*user_hook) {
+        rparams->hooks = user_hook;   // 1-Element-Array (Adresse des Pointers)
+        rparams->num_hooks = 1;
+    }
+}
+
+static void pl_apply_user_shader(struct priv *p)
+{
+    kk_apply_user_shader(p, p->gpu, &p->rparams, &p->user_hook, &p->user_shader_path);
+}
+
+// Per-Content-Debanding-Presets (G). Default (high_quality) = pl_deband_default_
+// params {1, 3.0, 16, 4.0}. mild = Realfilm, strong = mehr Iterationen für
+// SD-Cartoon-Verläufe. **Grain bewusst auf 1.0** (statt libplacebos 4.0): die
+// IQ-Harness-Messung (2026-06-04) zeigte, dass das strukturelle Debanding der
+// `threshold` folgt, das Grain aber nur Rauschen addiert (TV 252→441) — v.a. auf
+// flachen Cartoon-Flächen sichtbar. Niedriges Grain behält den Banding-Vorteil
+// ohne das Rausch-Manko. HDR → off (Header warnt: Grain verschiebt HDR-Helligkeit).
+static const struct pl_deband_params deband_mild = {
+    .iterations = 1, .threshold = 3.0f, .radius = 16.0f, .grain = 1.0f,
+};
+static const struct pl_deband_params deband_strong = {
+    .iterations = 2, .threshold = 4.0f, .radius = 16.0f, .grain = 1.0f,
+};
+
+// Debanding pro Content via env KUCKUCK_DEBAND: off|mild|strong; unset/anderes =
+// high_quality-Default. App-Gate setzt es pro Video. strcmp-Cache wie der Upscaler
+// (kein Reassign pro Frame). off spart den Deband-Compute-Pass ganz.
+// Core: shared by the mpv path (pl_apply_deband) and the hybrid path.
+static void kk_apply_deband(void *tactx, struct pl_render_params *rparams,
+                            char **deband_mode)
+{
+    const char *mode = getenv("KUCKUCK_DEBAND");
+    if (!mode)
+        mode = "";
+    const char *cur = *deband_mode ? *deband_mode : "";
+    if (strcmp(mode, cur) == 0)
+        return;
+    talloc_free(*deband_mode);
+    *deband_mode = talloc_strdup(tactx, mode);
+
+    if (strcmp(mode, "off") == 0)
+        rparams->deband_params = NULL;
+    else if (strcmp(mode, "mild") == 0)
+        rparams->deband_params = &deband_mild;
+    else if (strcmp(mode, "strong") == 0)
+        rparams->deband_params = &deband_strong;
+    else
+        rparams->deband_params = &pl_deband_default_params;  // unset/unbekannt
+}
+
+static void pl_apply_deband(struct priv *p)
+{
+    kk_apply_deband(p, &p->rparams, &p->deband_mode);
+}
+
+static int pl_init(struct render_backend *ctx, mpv_render_param *params)
+{
+    // Opt-in gate. render_backend_pl is registered before render_backend_gpu
+    // so it gets first crack at the Metal render API, but stays dormant unless
+    // explicitly enabled — the proven ra_metal path (render_backend_gpu)
+    // handles Metal by default. Set MPV_RENDER_PL=1 in the environment to route
+    // Metal rendering through libplacebo instead. Reversible without a rebuild;
+    // instant fallback by unsetting it. Remove this gate once validated.
+    const char *optin = getenv("MPV_RENDER_PL");
+    if (!optin || optin[0] != '1')
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    ctx->priv = talloc_zero(NULL, struct priv);
+    struct priv *p = ctx->priv;
+
+    // Only the Metal render API is supported for now.
+    char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
+    if (!api || strcmp(api, MPV_RENDER_API_TYPE_METAL) != 0)
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    mpv_metal_init_params *init =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_INIT_PARAMS, NULL);
+    if (!init || !init->device) {
+        MP_FATAL(ctx, "MPV_RENDER_PARAM_METAL_INIT_PARAMS.device is required.\n");
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    p->pllog = mppl_log_create(p, ctx->log);
+    if (!p->pllog)
+        return MPV_ERROR_GENERIC;
+
+    p->metal = pl_metal_create(p->pllog, pl_metal_params(
+        .device = init->device,
+        // Host-Queue teilen (wenn angeboten): Submissions des Hosts (PiP-Blit,
+        // Present-CB) ordnen sich automatisch hinter unser Frame-CB — die
+        // Voraussetzung für den No-finish-Pfad (s. pl_render Schritt 5).
+        .queue  = init->command_queue,
+    ));
+    if (!p->metal) {
+        MP_FATAL(ctx, "Failed creating libplacebo Metal device.\n");
+        return MPV_ERROR_GENERIC;
+    }
+    p->gpu = p->metal->gpu;
+
+    // OSD overlay texture formats: libass parts are A8 (r8), BGRA parts are
+    // premultiplied bgra8. Looked up once; NULL if unsupported (skipped later).
+    p->osd_fmt[SUBBITMAP_LIBASS] = pl_find_named_fmt(p->gpu, "r8");
+    p->osd_fmt[SUBBITMAP_BGRA]   = pl_find_named_fmt(p->gpu, "bgra8");
+
+    // Persisted shader cache: the Metal backend stores each pass's transpiled
+    // MSL here (keyed by GLSL hash), so a warm cache loaded from disk lets the
+    // first frame after a cold start skip the ~full-renderer shader transpile
+    // (otherwise several seconds of black). Attach before the renderer compiles
+    // anything (passes are built lazily on first render).
+    p->cache = pl_cache_create(pl_cache_params(
+        .log            = p->pllog,
+        .max_total_size = 16 << 20,   // 16 MiB — comfortably covers the graph
+    ));
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "rb");
+            if (f) {
+                pl_cache_load_file(p->cache, f);
+                fclose(f);
+            }
+        }
+        pl_gpu_set_cache(p->gpu, p->cache);
+    }
+
+    p->rr = pl_renderer_create(p->pllog, p->gpu);
+    if (!p->rr)
+        return MPV_ERROR_GENERIC;
+
+    // High-Quality-Render-Params (Debanding + ewa_lanczos + Sigmoid). Optional ein
+    // User-Shader (Anime4K etc.) aus env KUCKUCK_GLSL_SHADER: eine Datei mit einem
+    // (ggf. konkatenierten) mpv-User-Shader → pl_hook → params.hooks. App schaltet
+    // das per env (Toggle + Animation-Gate); fehlt es, identisch zu renderpl.19.
+    p->rparams = pl_render_high_quality_params;
+    // Error-Diffusion-Dithering (sierra-lite): besser als ordered Dithering gegen
+    // Banding in Verläufen (dunkle Cartoon-Szenen, SD→Retina). Billiger Compute-Pass.
+    p->rparams.error_diffusion = &pl_error_diffusion_sierra_lite;
+    pl_apply_user_shader(p);   // initialer Shader aus env (App-Gate); pl_render recheckt
+    pl_apply_deband(p);        // initiales Deband-Preset aus env (App-Gate)
+
+    p->queue = pl_queue_create(p->gpu);
+
+    // Zero-Copy-hwdec (J): VT-Device registrieren, damit vd_lavc
+    // hwdec=videotoolbox (ohne -copy) wählen kann. Ohne diesen Eintrag fiel
+    // plain videotoolbox historisch auf „Could not create device" → SW-Decode
+    // (mit den desaturierten Farben). Die IMGFMT_VIDEOTOOLBOX-Frames wrappt
+    // map_frame_pl/vt_wrap_map direkt (IOSurface → pl_tex, keine Kopie).
+    ctx->hwdec_devs = hwdec_devices_create();
+    AVBufferRef *vt_ref = NULL;
+    if (av_hwdevice_ctx_create(&vt_ref, AV_HWDEVICE_TYPE_VIDEOTOOLBOX,
+                               NULL, NULL, 0) >= 0) {
+        p->vt_hwdev = (struct mp_hwdec_ctx) {
+            .driver_name   = "videotoolbox",
+            .av_device_ref = vt_ref,
+            .hw_imgfmt     = IMGFMT_VIDEOTOOLBOX,
+        };
+        hwdec_devices_add(ctx->hwdec_devs, &p->vt_hwdev);
+        p->vt_hwdev_added = true;
+    }
+    if (!p->queue)
+        return MPV_ERROR_GENERIC;
+
+    ctx->driver_caps = VO_CAP_ROTATE90;
+    return 0;
+}
+
+static bool pl_check_format(struct render_backend *ctx, int imgfmt)
+{
+    struct priv *p = ctx->priv;
+    // Zero-Copy-hwdec: VT-Frames wrappen wir selbst (vt_wrap_map) —
+    // pl_test_pixfmt kennt das hw-Format auf dem Metal-Backend nicht.
+    if (imgfmt == IMGFMT_VIDEOTOOLBOX)
+        return p->vt_hwdev_added;
+    // A format is renderable if libplacebo's libav mapper can describe it.
+    // pl_test_pixfmt checks the underlying AVPixelFormat against the gpu's
+    // capabilities without needing an actual frame.
+    enum AVPixelFormat avfmt = imgfmt2pixfmt(imgfmt);
+    if (avfmt == AV_PIX_FMT_NONE)
+        return false;
+    return pl_test_pixfmt(p->gpu, avfmt);
+}
