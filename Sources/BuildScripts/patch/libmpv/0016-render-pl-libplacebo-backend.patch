+
+// Render mpv's OSD + subtitles at the given pts into pl_overlay structs and
+// attach them to the target frame. Ported from vo_gpu_next's update_overlays:
+// osd_render() returns packed bitmaps (A8 for libass, premultiplied BGRA for
+// image subs), which we upload into per-render_index cached textures and
+// describe as overlay parts. Coordinates are in the OSD resolution = the full
+// output (PL_OVERLAY_COORDS_DST_FRAME), so subs can land in the letterbox too.
+static void update_osd(struct priv *p, struct pl_frame *target, double pts)
+{
+    target->num_overlays = 0;
+    target->overlays = NULL;
+    if (!p->osd_state)
+        return;
+
+    struct sub_bitmap_list *subs =
+        osd_render(p->osd_state, p->osd, pts, 0, mp_draw_sub_formats);
+    if (!subs)
+        return;
+
+    struct osd_cache *cache = &p->osd_cache;
+    for (int n = 0; n < subs->num_items; n++) {
+        const struct sub_bitmaps *item = subs->items[n];
+        if (!item->num_parts || !item->packed)
+            continue;
+        if (item->render_index < 0 || item->render_index >= MAX_OSD_PARTS)
+            continue;
+        pl_fmt tex_fmt = p->osd_fmt[item->format];
+        if (!tex_fmt)
+            continue;
+        struct osd_entry *entry = &cache->entries[item->render_index];
+
+        // Reuse a pooled texture if this entry doesn't have one yet.
+        if (!entry->tex && p->num_sub_tex)
+            MP_TARRAY_POP(p->sub_tex, p->num_sub_tex, &entry->tex);
+        bool ok = pl_tex_recreate(p->gpu, &entry->tex, &(struct pl_tex_params) {
+            .format        = tex_fmt,
+            .w             = MPMAX(item->packed_w, entry->tex ? entry->tex->params.w : 0),
+            .h             = MPMAX(item->packed_h, entry->tex ? entry->tex->params.h : 0),
+            .host_writable = true,
+            .sampleable    = true,
+        });
+        if (!ok)
+            break;
+
+        struct pl_tex_transfer_params tr = {
+            .tex       = entry->tex,
+            .rc        = { .x1 = item->packed_w, .y1 = item->packed_h },
+            .row_pitch = item->packed->stride[0],
+            .ptr       = item->packed->planes[0],
+        };
+        // Async uploads read the source after this returns: keep the packed
+        // image alive via a ref freed by the upload callback.
+        if (p->gpu->limits.callbacks) {
+            tr.callback = talloc_free;
+            tr.priv     = mp_image_new_ref(item->packed);
+        }
+        ok = pl_tex_upload(p->gpu, &tr);
+        if (!ok) {
+            if (tr.priv)
+                talloc_free(tr.priv);
+            break;
+        }
+
+        entry->num_parts = 0;
+        for (int i = 0; i < item->num_parts; i++) {
+            const struct sub_bitmap *b = &item->parts[i];
+            if (b->dw == 0 || b->dh == 0)
+                continue;
+            uint32_t c = b->libass.color;   // RGBA packed, only used for libass
+            struct pl_overlay_part part = {
+                .src = { b->src_x, b->src_y, b->src_x + b->w, b->src_y + b->h },
+                .dst = { b->x, b->y, b->x + b->dw, b->y + b->dh },
+                .color = {
+                    (c >> 24) / 255.0f,
+                    ((c >> 16) & 0xFF) / 255.0f,
+                    ((c >> 8) & 0xFF) / 255.0f,
+                    (255 - (c & 0xFF)) / 255.0f,
+                },
+            };
+            MP_TARRAY_APPEND(p, entry->parts, entry->num_parts, part);
+        }
+
+        struct pl_overlay *ol = &cache->overlays[target->num_overlays++];
+        *ol = (struct pl_overlay) {
+            .tex       = entry->tex,
+            .parts     = entry->parts,
+            .num_parts = entry->num_parts,
+            .color     = pl_color_space_srgb,
+            .coords    = PL_OVERLAY_COORDS_DST_FRAME,
+        };
+        switch (item->format) {
+        case SUBBITMAP_BGRA:
+            ol->mode = PL_OVERLAY_NORMAL;
+            ol->repr.alpha = PL_ALPHA_PREMULTIPLIED;
+            break;
+        case SUBBITMAP_LIBASS:
+            ol->mode = PL_OVERLAY_MONOCHROME;
+            ol->repr.alpha = PL_ALPHA_INDEPENDENT;
+            break;
+        default:
+            break;
+        }
+    }
+
+    if (target->num_overlays)
+        target->overlays = cache->overlays;
+    talloc_free(subs);
+}
+
+// H-Instrumentierung (temporär): misst die pl_gpu_finish-Dauer = wie lange der
+// Render-Thread pro Frame blockiert, bis die GPU fertig ist. Dumpt avg/max alle
+// 300 Frames nach Documents/gpu-finish.log — NUR wenn env KUCKUCK_GPU_PROFILE
+// gesetzt ist; sonst nackter pl_gpu_finish ohne jeden Overhead. Belegt objektiv,
+// ob der Cross-Queue-Barrier-Stall relevant genug für den H-Redesign ist.
+static void gpu_finish_profiled(struct priv *p)
+{
+    if (!getenv("KUCKUCK_GPU_PROFILE")) {
+        pl_gpu_finish(p->gpu);
+        return;
+    }
+    static uint64_t n, sum_ns, max_ns;
+    uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    pl_gpu_finish(p->gpu);
+    uint64_t dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0;
+    sum_ns += dt; n++;
+    if (dt > max_ns) max_ns = dt;
+    if (n >= 300) {
+        const char *home = getenv("HOME");
+        char path[PATH_MAX];
+        if (home && snprintf(path, sizeof path, "%s/Documents/gpu-finish.log", home) < (int) sizeof path) {
+            FILE *f = fopen(path, "a");
+            if (f) {
+                fprintf(f, "gpu_finish avg=%.1fus max=%.1fus n=%llu\n",
+                        sum_ns / (double) n / 1000.0, max_ns / 1000.0, (unsigned long long) n);
+                fclose(f);
+            }
+        }
+        n = 0; sum_ns = 0; max_ns = 0;
+    }
+}
+
+static int pl_render(struct render_backend *ctx, mpv_render_param *params,
+                     struct vo_frame *frame)
+{
+    struct priv *p = ctx->priv;
+
+    // Pro-Video Hot-Swap des User-Shaders + Deband-Presets (App setzt env pro
+    // Content-Gate). Billiger strcmp-Guard; wechselt nur bei echtem Wechsel.
+    pl_apply_user_shader(p);
+    pl_apply_deband(p);
+
+    // GPU-Deinterlacing (A): App setzt KUCKUCK_DEINTERLACE für raw-TS-Tuner-Live-TV
+    // (576i, oft NICHT als interlaced geflaggt → erzwungen statt am Flag). pl_queue
+    // rendert pro Feld. map_frame_pl markt das Feld. Wert wählt den Algorithmus:
+    //   "1"/"bwdif" = BWDIF (beste, schwerste) · "yadif" = YADIF · "yadif-fast" =
+    //   YADIF+skip_spatial_check (leichter) · "bob" = Zeilenverdopplung (am leichtesten).
+    // Ziel: schärfste Stufe finden, die stabil 50p hält (App-Picker schaltet live um).
+    const char *di = getenv("KUCKUCK_DEINTERLACE");
+    p->deint = di && di[0] != '\0' && strcmp(di, "0") != 0;
+    if (p->deint && (!p->deint_algo || strcmp(p->deint_algo, di) != 0)) {
+        talloc_free(p->deint_algo);
+        p->deint_algo = talloc_strdup(p, di);
+        p->deint_params = pl_deinterlace_default_params;  // BWDIF-Basis
+        if (strcmp(di, "yadif") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_YADIF;
+        } else if (strcmp(di, "yadif-fast") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_YADIF;
+            p->deint_params.skip_spatial_check = true;
+        } else if (strcmp(di, "bob") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_BOB;
+        }  // "1"/"bwdif"/sonst → Default (BWDIF)
+    }
+    p->rparams.deinterlace_params = p->deint ? &p->deint_params : NULL;
+
+    // Resolution-Render-Gate: ab ≥1080p-Quelle den teuren POLAREN ewa_lanczossharp-
+    // Upscaler durch einen SEPARABLEN Lanczos ersetzen. 1080p→Retina ist ein
+    // moderater Upscale (~2,4×) → optisch nahezu identisch, aber der Polar-Scaler
+    // war render-gebunden (~50ms/Frame → HD-Sport fiel auf 25 statt 50fps). 720p/SD
+    // behalten den polaren HQ-Scaler (dort hält's 50fps). KUCKUCK_HD_LIGHT=0 → aus (A/B).
+    int src_h = (frame && frame->current) ? frame->current->h : 0;
+    const char *hl = getenv("KUCKUCK_HD_LIGHT");
+    if (!(hl && hl[0] == '0') && (src_h >= 1080 || p->deint)) {
+        // Light-Render-Pfad: separabler Scaler + Deband + Error-Diffusion-Dither weg.
+        // Greift bei (a) HD ≥1080p (App rendert ~quell-aufgelöst → Budget eng) UND
+        // (b) Deinterlacing (raw-TS 576i: das per-Feld-50p-Deint ist schon teuer, der
+        // schwere polare Scaler + Dither obendrauf reißt das 60Hz-Budget → ~22fps).
+        // Dither/Deband sind auf dem stark hochskalierten SD/HD-Bild kaum sichtbar.
+        p->rparams.upscaler = &pl_filter_lanczos;
+        p->rparams.deband_params = NULL;
+        p->rparams.error_diffusion = NULL;
+    } else {
+        // SD/720p: polarer HQ-Scaler + Dither. Deband authoritativ aus dem env neu
+        // bestimmen (pl_apply_deband-strcmp-Cache hat es nach HD evtl. nicht restored).
+        p->rparams.upscaler = pl_render_high_quality_params.upscaler;
+        p->rparams.error_diffusion = &pl_error_diffusion_sierra_lite;
+        const char *dm = getenv("KUCKUCK_DEBAND");
+        if (dm && strcmp(dm, "off") == 0)         p->rparams.deband_params = NULL;
+        else if (dm && strcmp(dm, "mild") == 0)   p->rparams.deband_params = &deband_mild;
+        else if (dm && strcmp(dm, "strong") == 0) p->rparams.deband_params = &deband_strong;
+        else                                      p->rparams.deband_params = &pl_deband_default_params;
+    }
+
+    mpv_metal_drawable *dr =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_DRAWABLE, NULL);
+    if (!dr || !dr->texture)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // 1. Wrap the caller's destination texture as a libplacebo render target.
+    pl_tex target_tex = pl_metal_wrap_tex(p->metal, dr->texture);
+    if (!target_tex)
+        return MPV_ERROR_GENERIC;
+
+    // Target colour space derived from the drawable's pixel format instead of
+    // hardcoded: an 8/10-bit unorm drawable is sRGB; a float drawable (set up
+    // by the host for EDR/HDR output) gets an HDR10 target so the renderer
+    // tone-maps into HDR rather than clipping to SDR.
+    bool hdr_target = target_tex->params.format &&
+                      target_tex->params.format->type == PL_FMT_FLOAT;
+    // Peak-Detection NUR fuer HDR. SDR braucht sie nicht — und mit prod-4 (MR!861,
+    // max-peak-Detection-Umbau) verschiebt sie bei aktivem User-Shader die Belichtung:
+    // CAS/ArtCNN heben lokale Spitzen -> hoeher gemessener Peak -> Roll-off dimmt das
+    // ganze SDR-Bild einen Tick zu dunkel (ohne Shader unauffaellig). Nur HDR behaelt
+    // die (dort gewollte + MR!861-korrekte) Peak-Detection.
+    p->rparams.peak_detect_params = hdr_target ? &pl_peak_detect_high_quality_params : NULL;
+    // Helligkeits-Nudge: SDR-Broadcast (bt.1886, Gamma 2.4) wirkt auf dem Handy
+    // (~sRGB 2.2-Erwartung) einen Tick zu dunkel — colorimetrisch korrekt, aber
+    // gefühlt flau. Die App setzt KUCKUCK_SDR_GAMMA NUR für SDR-Live-TV (Tuner +
+    // Mediathek-Live); YouTube/HDR/VOD bleiben ungesetzt = neutral. libplacebos
+    // gamma wirkt als x^(1/gamma) → gamma>1 hebt die Mitteltöne (kein Schwarz-Lift
+    // wie brightness). Nur bei HDR-Target ignorieren (HDR hat den Effekt nicht).
+    {
+        const char *sg = (!hdr_target) ? getenv("KUCKUCK_SDR_GAMMA") : NULL;
+        float gamma = sg ? (float) atof(sg) : 1.0f;
+        if (gamma > 1.001f || gamma < 0.999f) {
+            p->color_adj = pl_color_adjustment_neutral;
+            p->color_adj.gamma = gamma;
+            p->rparams.color_adjustment = &p->color_adj;
+        } else {
+            p->rparams.color_adjustment = NULL;  // neutral
+        }
+    }
+    // HDR-Target an die ECHTE Display-Faehigkeit koppeln statt generisches HDR10.
+    // pl_color_space_hdr10 = BT.2020/PQ mit ~10000-nit-Peak -> bei iPhone-Content
+    // (1000-4000 nit) praktisch Passthrough: keine Highlight-Roll-off -> "grell"
+    // (gemessen via tools/iq-harness/hdr_probe). Der CAMetalLayer ist itur_2100_PQ
+    // (BT.2020/PQ) -> Primaries+Transfer BEIBEHALTEN (sonst Desaturierung wie bei
+    // frueheren target-prim/trc-Overrides), nur max_luma auf die reale EDR-Peak
+    // deckeln -> libplacebo rollt hellen Content sauber auf den Display-Peak ab
+    // (mit MR !861 frame-peak-adaptiv). KUCKUCK_HDR_TARGET=hdr10 stellt das alte
+    // (ungedeckelte) Verhalten wieder her; KUCKUCK_HDR_TARGET_NITS setzt den Peak.
+    struct pl_color_space hdr_csp = pl_color_space_hdr10;
+    {
+        const char *hmode = getenv("KUCKUCK_HDR_TARGET");
+        const char *hnits = getenv("KUCKUCK_HDR_TARGET_NITS");
+        if (!(hmode && strcmp(hmode, "hdr10") == 0))
+            hdr_csp.hdr.max_luma = hnits ? (float) atof(hnits) : 1000.0f;
+    }
+    struct pl_swapchain_frame sw_frame = {
+        .fbo         = target_tex,
+        .flipped     = false,
+        .color_repr  = pl_color_repr_rgb,
+        .color_space = hdr_target ? hdr_csp : pl_color_space_srgb,
+    };
+    struct pl_frame target;
+    pl_frame_from_swapchain(&target, &sw_frame);
+
+    // Aspect-correct placement: mpv computed the on-screen video rect (dst,
+    // letterboxed within the drawable) in resize(). pl_frame_from_swapchain
+    // defaults target.crop to the whole drawable, which would stretch the video
+    // to fill — override with mpv's dst rect so the renderer letterboxes (the
+    // area outside the crop is cleared to black). The source crop (src) is
+    // applied per-frame in map_frame_pl.
+    target.crop = (struct pl_rect2df) {
+        .x0 = p->dst.x0, .y0 = p->dst.y0,
+        .x1 = p->dst.x1, .y1 = p->dst.y1,
+    };
+
+    // 2. Feed the frame queue. mpv hands us the current frame plus any
+    //    neighbours it wants available for display-synced interpolation
+    //    (frame->frames[]); the queue dedups by frame_id, maps lazily and
+    //    evicts past frames. On seek mpv calls reset() -> want_reset, which we
+    //    drain here so the queue restarts cleanly at the new position.
+    //
+    // Interpolation parity with vo_gpu_next (Kuckuck #3): only blend when mpv
+    // actually display-syncs a multi-frame window (interpolation=yes). For the
+    // single-frame path (interpolation=no -> num_frames==1) can_interpolate is
+    // false and pts_offset / vsync_duration / source duration are 0 — the queue
+    // holds exactly the current frame at its pts, nothing is blended (the path
+    // that was the only one tested before). Without this distinction a naive
+    // multi-frame mix renders black: the target display time is pts +
+    // ideal_frame_vsync, and querying the queue at the bare current->pts (no
+    // offset, no clamp) returns PL_QUEUE_MORE with no frames -> empty mix.
+    bool can_interpolate = frame && frame->current && frame->display_synced &&
+                           !frame->still && frame->num_frames > 1;
+    double pts_offset = can_interpolate ? frame->ideal_frame_vsync : 0;
+
+    // Queue-refill guard (vo_gpu_next): if the queue's front frame is already
+    // ahead of our target pts, the queue desynced (e.g. seek) — force a reset so
+    // it refills cleanly instead of returning an empty (black) mix. Skipped when
+    // a reset is already pending (mpv's reset() on seek sets want_reset first).
+    if (frame && frame->current && !p->want_reset) {
+        struct pl_source_frame vpts;
+        if (pl_queue_peek(p->queue, 0, &vpts) &&
+            frame->current->pts + MPMAX(0, pts_offset) < vpts.pts)
+            p->want_reset = true;
+    }
+    if (p->want_reset) {
+        pl_queue_reset(p->queue);
+        p->last_id = 0;
+        p->want_reset = false;
+    }
+    for (int n = 0; frame && n < frame->num_frames; n++) {
+        uint64_t id = frame->frame_id + n;
+        if (id <= p->last_id)
+            continue;  // already queued in an earlier render call
+        struct mp_image *mpi = mp_image_new_ref(frame->frames[n]);
+        if (!mpi)
+            continue;
+        struct frame_ref *fr = talloc_zero(NULL, struct frame_ref);
+        fr->magic = KUCKUCK_FR_MAGIC;
+        fr->p   = p;
+        fr->mpi = mpi;
+        pl_queue_push(p->queue, &(struct pl_source_frame) {
+            .pts        = mpi->pts,
+            .duration   = can_interpolate ? frame->approx_duration : 0,
+            .frame_data = fr,
+            .map        = map_frame_pl,
+            .unmap      = unmap_frame_pl,
+            .discard    = discard_frame_pl,
+        });
+        p->last_id = id;
+    }
+
+    // 3. Pull the frame mix for the current display time. With interpolation the
+    //    target is pts + pts_offset and vsync_duration drives the blend; without
+    //    it both are 0 and the mix holds the single current frame.
+    struct pl_frame_mix mix = {0};
+    enum pl_queue_status st = PL_QUEUE_OK;
+    if (frame && frame->current) {
+        struct pl_queue_params qparams = *pl_queue_params(
+            .pts                     = frame->current->pts + pts_offset,
+            // Kuckuck: high-quality statt default render-params (Debanding +
+            // ewa_lanczos-Upscaler + Sigmoid). Radius MUSS zu den Render-params
+            // passen (Interpolations-Konsistenz).
+            .radius                  = pl_frame_mix_radius(&p->rparams),
+            .vsync_duration          = can_interpolate ? frame->ideal_frame_vsync_duration : 0,
+            .interpolation_threshold = 0.01,  // mpv-Default: nahe 1:1-Ratio nicht blenden
+        );
+        // We may be up to half a vsync before the current frame time. If the
+        // queue's first frame is ahead of the requested pts, start there —
+        // otherwise pl_queue returns MORE with an empty mix (black).
+        struct pl_source_frame first;
+        if (pl_queue_peek(p->queue, 0, &first) && qparams.pts < first.pts)
+            qparams.pts = first.pts;
+        st = pl_queue_update(p->queue, &mix, &qparams);
+    }
+
+    // 3b. OSD + subtitles at the current display pts → pl_overlay on the
+    //     target. Composited by pl_render_image_mix in the same pass.
+    double osd_pts = (frame && frame->current) ? frame->current->pts : 0;
+    update_osd(p, &target, osd_pts);
+
+    // 4. Render.
+    //    Motion-Interp (env KUCKUCK_VT_INTERP, App-gated auf Tuner-Realfilm
+    //    ~50fps): liegt die Display-Zeit zwischen zwei VT-SR-Quellframes
+    //    (Phase 0.12..0.88), synthetisiert die App-Bridge das Zwischenbild
+    //    (optical flow @Quell-Res, dann 2x-SR) und wir rendern DAS statt des
+    //    Mixes — eliminiert den inhärenten 50-auf-60-Judder. Jeder Fehlschlag
+    //    fällt lautlos auf den normalen Mix-Render zurück.
+    bool did_interp = false;
+    const char *ienv = getenv("KUCKUCK_VT_INTERP");
+    if (ienv && strcmp(ienv, "1") == 0 && st == PL_QUEUE_OK && mix.num_frames >= 2) {
+        static int mi_calls, mi_synth, mi_nomix;
+        static int mi_nofr, mi_nosrc, mi_phase, mi_bridge;
+        mi_calls++;
+        int prev_i = -1, next_i = -1;
+        for (int i = 0; i < mix.num_frames; i++) {
+            float ts = mix.timestamps[i];
+            if (ts <= 0 && (prev_i < 0 || ts > mix.timestamps[prev_i]))
+                prev_i = i;
+            if (ts > 0 && (next_i < 0 || ts < mix.timestamps[next_i]))
+                next_i = i;
+        }
+        if (prev_i >= 0 && next_i >= 0) {
+            struct frame_ref *fp = mix.frames[prev_i]->user_data;
+            struct frame_ref *fn = mix.frames[next_i]->user_data;
+            float span = mix.timestamps[next_i] - mix.timestamps[prev_i];
+            float phase = span > 0 ? -mix.timestamps[prev_i] / span : 0;
+            bool fr_ok = fp && fn && fp->magic == KUCKUCK_FR_MAGIC &&
+                         fn->magic == KUCKUCK_FR_MAGIC;
+            bool src_ok = fr_ok && fp->vt_src_pixbuf && fn->vt_src_pixbuf;
+            // Enges Fenster: nur das Worst-Case-Frame (Phase ~0.5 = halber
+            // Frame daneben) synthetisieren. Die ±1/6-Phasen zeigen kaum
+            // sichtbaren Versatz, aber jede Synthese riskiert Optical-Flow-
+            // Wabern (statisches Logo über bewegtem Hintergrund) — Vollglättung
+            // (0.12..0.88, 83% synth) waberte sichtbar.
+            bool ph_ok = phase > 0.38f && phase < 0.62f;
+            if (!fr_ok) mi_nofr++;
+            else if (!src_ok) mi_nosrc++;
+            else if (!ph_ok) mi_phase++;
+            if (fr_ok && src_ok && ph_ok)
+            {
+                void *pixbuf = NULL, *iosurf = NULL;
+                int ow = 0, oh = 0;
+                int irc = kuckuck_vt_interp_sr(fp->vt_src_pixbuf, fn->vt_src_pixbuf,
+                                               phase, &pixbuf, &iosurf, &ow, &oh);
+                if (irc != 0)
+                    mi_bridge++;
+                if (irc == 0)
+                {
+                    pl_fmt fmt_l = pl_find_named_fmt(p->gpu, "r8");
+                    pl_fmt fmt_c = pl_find_named_fmt(p->gpu, "rg8");
+                    pl_tex luma   = fmt_l ? pl_metal_wrap_iosurface(p->metal, iosurf, 0, ow, oh, fmt_l) : NULL;
+                    pl_tex chroma = fmt_c ? pl_metal_wrap_iosurface(p->metal, iosurf, 1, ow / 2, oh / 2, fmt_c) : NULL;
+                    if (luma && chroma) {
+                        // Frame-Setup vom "next"-Nachbarn übernehmen (gleiche
+                        // Dims/Crop/Repr — nur die Texturen sind das Synth-Bild).
+                        struct pl_frame synth = *mix.frames[next_i];
+                        synth.planes[0].texture = luma;
+                        synth.planes[1].texture = chroma;
+                        synth.num_overlays = 0;   // OSD hängt am Target
+                        pl_render_image(p->rr, &synth, &target, &p->rparams);
+                        did_interp = true;
+                        mi_synth++;
+                    }
+                    pl_tex_destroy(p->gpu, &luma);
+                    pl_tex_destroy(p->gpu, &chroma);
+                    kuckuck_vt_release(pixbuf);
+                }
+            }
+        } else {
+            mi_nomix++;
+        }
+        if (mi_calls % 300 == 0) {
+            const char *home2 = getenv("HOME");
+            char path2[PATH_MAX];
+            if (home2 && snprintf(path2, sizeof path2, "%s/Documents/vt-mi.log", home2) < (int) sizeof path2) {
+                FILE *f2 = fopen(path2, "a");
+                if (f2) {
+                    fprintf(f2, "[vt-mi] calls=%d synth=%d nomix=%d nofr=%d nosrc=%d phase=%d bridge=%d mixN=%d\n",
+                            mi_calls, mi_synth, mi_nomix, mi_nofr, mi_nosrc, mi_phase, mi_bridge, mix.num_frames);
+                    fclose(f2);
+                }
+            }
+        }
+    }
+    // An empty mix (e.g. right after a seek, before frames arrive)
+    // clears the target; PL_QUEUE_MORE still yields the available frames.
+    if (!did_interp && st != PL_QUEUE_ERR)
+        pl_render_image_mix(p->rr, &mix, &target, &p->rparams);
+
+    // 5. Synchronisation zum Host-Present — zwei Modi:
+    //    Default: pl_gpu_finish blockt bis die GPU fertig ist, der Host darf
+    //    danach bare [drawable present] rufen (einzige Barriere, wenn der Host
+    //    eine EIGENE Queue nutzt oder CPU-seitig presentet).
+    //    KUCKUCK_NO_FINISH=1 (App-gated): nur Frame-CB committen (pl_gpu_flush),
+    //    KEIN Warten. Voraussetzungen (beide App-seitig erfüllt): (a) der Host
+    //    teilt seine MTLCommandQueue via init_params.command_queue, (b) der Host
+    //    presentet über einen CB auf DERSELBEN Queue (nicht CPU-seitig
+    //    drawable.present) — die Queue-FIFO ordnet Present + PiP-Blit hinter
+    //    unser Frame-CB, ohne CPU-Wait. Der Render-Thread spart die volle
+    //    GPU-Frame-Zeit (~8-13ms gemessen). gpu_finish_profiled misst die
+    //    Stall-Dauer im finish-Modus, wenn KUCKUCK_GPU_PROFILE gesetzt ist.
+    const char *nofin = getenv("KUCKUCK_NO_FINISH");
+    if (nofin && strcmp(nofin, "1") == 0) {
+        pl_gpu_flush(p->gpu);
+    } else {
+        gpu_finish_profiled(p);
+    }
+
+    pl_tex_destroy(p->gpu, &target_tex);
+
+    (void) ctx;
+    return 0;
+}
+
+// mpv sets need_reset on seek/reconfig. Defer the actual pl_queue_reset to the
+// next render (same render thread, just before the push loop) so we never touch
+// the queue concurrently and the new frames repopulate it in one place.
+static void pl_reset(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+    p->want_reset = true;
+}
+
+// mpv sets need_update_external on first frame + when the VO's OSD/overlay
+// source changes. We borrow vo->osd here (lifetime managed by the player) and
+// call osd_render() against it each frame in update_osd. vo may be NULL — then
+// OSD is simply skipped.
+static void pl_update_external(struct render_backend *ctx, struct vo *vo)
+{
+    struct priv *p = ctx->priv;
+    p->osd_state = vo ? vo->osd : NULL;
+}
+
+static void pl_destroy(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p)
+        return;
+    // Zero-Copy-hwdec: Device deregistrieren + freigeben, Liste zerstören.
+    if (p->vt_hwdev_added) {
+        hwdec_devices_remove(ctx->hwdec_devs, &p->vt_hwdev);
+        av_buffer_unref(&p->vt_hwdev.av_device_ref);
+    }
+    hwdec_devices_destroy(ctx->hwdec_devs);
+    ctx->hwdec_devs = NULL;
+    // Destroys the queue first: it unmaps/discards every cached frame (freeing
+    // the AVFrames + mp_image refs) and the plane textures it owns.
+    pl_queue_destroy(&p->queue);
+    pl_renderer_destroy(&p->rr);
+    if (p->user_hook)
+        pl_mpv_user_shader_destroy(&p->user_hook);
+    // Flush the (now warm) shader cache back to disk, then detach it from the
+    // gpu before the gpu itself is destroyed.
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "wb");
+            if (f) {
+                pl_cache_save_file(p->cache, f);
+                fclose(f);
+            }
+        }
+        if (p->gpu)
+            pl_gpu_set_cache(p->gpu, NULL);
+        pl_cache_destroy(&p->cache);
+    }
+    // OSD textures (cached entries + recycle pool). entry->parts are talloc
+    // children of p and freed with ctx->priv.
+    if (p->gpu) {
+        for (int i = 0; i < MAX_OSD_PARTS; i++)
+            pl_tex_destroy(p->gpu, &p->osd_cache.entries[i].tex);
+        for (int i = 0; i < p->num_sub_tex; i++)
+            pl_tex_destroy(p->gpu, &p->sub_tex[i]);
+    }
+    pl_metal_destroy(&p->metal);
+    // p->pllog is a talloc child of p; freed with ctx->priv.
+}
+
+const struct render_backend_fns render_backend_pl = {
+    .init            = pl_init,
+    .check_format    = pl_check_format,
+    .set_parameter   = pl_set_parameter,
+    .reconfig        = pl_reconfig,
+    .reset           = pl_reset,
+    .update_external = pl_update_external,
+    .resize          = pl_resize,
+    .get_target_size = pl_get_target_size,
+    .render          = pl_render,
+    .destroy         = pl_destroy,
+};
+
+// ===========================================================================
+// Kuckuck Hybrid render path (Increment 1: minimal CVPixelBuffer -> drawable)
+// ---------------------------------------------------------------------------
+// A standalone libplacebo entry, decoupled from mpv's render_backend/vo. The
+// host runs an AVPlayer (decode + seamless HLS-ABR) and feeds the decoded
+// CVPixelBuffers here; we render them through pl_renderer into a CAMetalLayer
+// drawable that the host acquires + presents. This first increment proves the
+// plumbing (device -> pl_gpu, IOSurface -> pl_frame, drawable -> target,
+// pl_render_image, present) with the base high-quality params only — the
+// per-content user-shader / deband / VT-SR hooks are added in Increment 2.
+// Public API declared in include/mpv/render_mtl.h.
+// ===========================================================================
+
+struct hybrid_priv {
+    pl_log pllog;
+    pl_metal metal;
+    pl_gpu gpu;
+    pl_renderer rr;
+    pl_cache cache;
+    struct pl_render_params rparams;
+    // Per-content quality (Increment 2): user-shader (ArtCNN/CAS/Anime4K) +
+    // deband, env-driven exactly like the mpv path. user_hook needs a stable
+    // address (rparams.hooks points at it). strcmp-cached → no fopen/parse per
+    // frame unless the env path actually changes.
+    const struct pl_hook *user_hook;
+    char *user_shader_path;
+    char *deband_mode;
+};
+
+static void hybrid_log_cb(void *priv, enum pl_log_level level, const char *msg)
+{
+    (void) priv; (void) level;
+    fprintf(stderr, "[hybrid/pl] %s\n", msg);
+}
+
+// CoreVideo colour attachment -> libplacebo enums. Missing attachments default
+// to BT.709 SDR (the Mediathek-live common case). CVBufferGetAttachment returns
+// an unretained value (no release), and is warning-free at the slice's iOS-14
+// deployment target (unlike CVBufferCopyAttachment, iOS-15+).
+static enum pl_color_system hybrid_matrix(CVPixelBufferRef pb)
+{
+    CFTypeRef m = CVBufferGetAttachment(pb, kCVImageBufferYCbCrMatrixKey, NULL);
+    if (!m) return PL_COLOR_SYSTEM_BT_709;
+    if (CFEqual(m, kCVImageBufferYCbCrMatrix_ITU_R_601_4))
+        return PL_COLOR_SYSTEM_BT_601;
+    if (CFEqual(m, kCVImageBufferYCbCrMatrix_SMPTE_240M_1995))
+        return PL_COLOR_SYSTEM_SMPTE_240M;
+    if (CFEqual(m, kCVImageBufferYCbCrMatrix_ITU_R_2020))
+        return PL_COLOR_SYSTEM_BT_2020_NC;
+    return PL_COLOR_SYSTEM_BT_709;
+}
+
+static enum pl_color_primaries hybrid_prim(CVPixelBufferRef pb)
+{
+    CFTypeRef pr = CVBufferGetAttachment(pb, kCVImageBufferColorPrimariesKey, NULL);
+    if (!pr) return PL_COLOR_PRIM_BT_709;
+    if (CFEqual(pr, kCVImageBufferColorPrimaries_EBU_3213))
+        return PL_COLOR_PRIM_BT_601_625;
+    if (CFEqual(pr, kCVImageBufferColorPrimaries_SMPTE_C))
+        return PL_COLOR_PRIM_BT_601_525;
+    if (CFEqual(pr, kCVImageBufferColorPrimaries_ITU_R_2020))
+        return PL_COLOR_PRIM_BT_2020;
+    return PL_COLOR_PRIM_BT_709;
+}
+
+static enum pl_color_transfer hybrid_trc(CVPixelBufferRef pb)
+{
+    CFTypeRef tf = CVBufferGetAttachment(pb, kCVImageBufferTransferFunctionKey, NULL);
+    if (!tf) return PL_COLOR_TRC_BT_1886;
+    if (CFEqual(tf, kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ))
+        return PL_COLOR_TRC_PQ;
+    if (CFEqual(tf, kCVImageBufferTransferFunction_ITU_R_2100_HLG))
+        return PL_COLOR_TRC_HLG;
+    return PL_COLOR_TRC_BT_1886;
+}
+
+// Wrap a decoded CVPixelBuffer's IOSurface planes as a pl_frame (zero-copy,
+// like vt_wrap_map but from a raw buffer with no mp_image). NV12 -> r8/rg8,
+// P010 -> r16/rg16. On success fills *frame + tex_out[2]; caller destroys the
+// textures after render.
+static bool hybrid_wrap_pixbuf(struct hybrid_priv *p, CVPixelBufferRef pb,
+                               struct pl_frame *frame, pl_tex tex_out[2])
+{
+    IOSurfaceRef surf = pb ? CVPixelBufferGetIOSurface(pb) : NULL;
+    if (!surf)
+        return false;
+
+    OSType pf = CVPixelBufferGetPixelFormatType(pb);
+    const char *lname, *cname;
+    struct pl_bit_encoding bits;
+    enum pl_color_levels levels;
+    switch (pf) {
+    case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+        lname = "r8"; cname = "rg8"; levels = PL_COLOR_LEVELS_LIMITED;
+        bits = (struct pl_bit_encoding) { .sample_depth = 8, .color_depth = 8 };
+        break;
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        lname = "r8"; cname = "rg8"; levels = PL_COLOR_LEVELS_FULL;
+        bits = (struct pl_bit_encoding) { .sample_depth = 8, .color_depth = 8 };
+        break;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        lname = "r16"; cname = "rg16"; levels = PL_COLOR_LEVELS_LIMITED;
+        bits = (struct pl_bit_encoding) { .sample_depth = 16, .color_depth = 10,
+                                          .bit_shift = 6 };
+        break;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        lname = "r16"; cname = "rg16"; levels = PL_COLOR_LEVELS_FULL;
+        bits = (struct pl_bit_encoding) { .sample_depth = 16, .color_depth = 10,
+                                          .bit_shift = 6 };
+        break;
+    default:
+        return false;   // unsupported CV pixel format
+    }
+
+    int w  = (int) CVPixelBufferGetWidthOfPlane(pb, 0);
+    int h  = (int) CVPixelBufferGetHeightOfPlane(pb, 0);
+    int cw = (int) CVPixelBufferGetWidthOfPlane(pb, 1);
+    int ch = (int) CVPixelBufferGetHeightOfPlane(pb, 1);
+    pl_fmt fl = pl_find_named_fmt(p->gpu, lname);
+    pl_fmt fc = pl_find_named_fmt(p->gpu, cname);
+    pl_tex luma   = fl ? pl_metal_wrap_iosurface(p->metal, surf, 0, w, h, fl) : NULL;
+    pl_tex chroma = fc ? pl_metal_wrap_iosurface(p->metal, surf, 1, cw, ch, fc) : NULL;
+    if (!luma || !chroma) {
+        pl_tex_destroy(p->gpu, &luma);
+        pl_tex_destroy(p->gpu, &chroma);
+        return false;
+    }
+
+    *frame = (struct pl_frame) {
+        .num_planes = 2,
+        .planes = {
+            { .texture = luma, .components = 1,
+              .component_mapping = { PL_CHANNEL_Y, PL_CHANNEL_NONE,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+            { .texture = chroma, .components = 2,
+              .component_mapping = { PL_CHANNEL_CB, PL_CHANNEL_CR,
+                                     PL_CHANNEL_NONE, PL_CHANNEL_NONE } },
+        },
+        .repr = {
+            .sys    = hybrid_matrix(pb),
+            .levels = levels,
+            .bits   = bits,
+        },
+        .color = {
+            .primaries = hybrid_prim(pb),
+            .transfer  = hybrid_trc(pb),
+        },
+        .crop = { .x0 = 0, .y0 = 0, .x1 = w, .y1 = h },
+    };
+    pl_frame_set_chroma_location(frame, PL_CHROMA_LEFT);
+    tex_out[0] = luma;
+    tex_out[1] = chroma;
+    return true;
+}
+
+void *kuckuck_hybrid_create(void *mtl_device)
+{
+    if (!mtl_device)
+        return NULL;
+    struct hybrid_priv *p = talloc_zero(NULL, struct hybrid_priv);
+
+    p->pllog = pl_log_create(PL_API_VER, pl_log_params(
+        .log_cb    = hybrid_log_cb,
+        .log_level = PL_LOG_WARN,
+    ));
+    if (!p->pllog)
+        goto fail;
+
+    // Own queue (queue=NULL): the hybrid path isn't sharing the host queue yet
+    // (no-finish/shared-queue present is a later increment).
+    p->metal = pl_metal_create(p->pllog, pl_metal_params(
+        .device = mtl_device,
+    ));
+    if (!p->metal) {
+        fprintf(stderr, "[hybrid/pl] pl_metal_create failed\n");
+        goto fail;
+    }
+    p->gpu = p->metal->gpu;
+
+    // Reuse the same persisted GLSL->MSL transpile cache as the mpv path
+    // (shared file → warm first frame regardless of which path opened it).
+    p->cache = pl_cache_create(pl_cache_params(
+        .log            = p->pllog,
+        .max_total_size = 16 << 20,
+    ));
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "rb");
+            if (f) { pl_cache_load_file(p->cache, f); fclose(f); }
+        }
+        pl_gpu_set_cache(p->gpu, p->cache);
+    }
+
+    p->rr = pl_renderer_create(p->pllog, p->gpu);
+    if (!p->rr)
+        goto fail;
+
+    p->rparams = pl_render_high_quality_params;
+    p->rparams.error_diffusion = &pl_error_diffusion_sierra_lite;
+    // SDR target for Increment 1 → peak-detect off (matches the mpv SDR path).
+    p->rparams.peak_detect_params = NULL;
+
+    return p;
+
+fail:
+    kuckuck_hybrid_destroy(p);
+    return NULL;
+}
+
+int kuckuck_hybrid_render(void *ctx, void *cv_pixbuf, void *target_texture)
+{
+    struct hybrid_priv *p = ctx;
+    if (!p || !cv_pixbuf || !target_texture)
+        return -1;
+    CVPixelBufferRef pb = (CVPixelBufferRef) cv_pixbuf;
+
+    // Per-content quality hot-swap (Increment 2): the host sets KUCKUCK_GLSL_SHADER
+    // / KUCKUCK_DEBAND per content (same env as the mpv path); apply both here.
+    // strcmp-guarded → only reparses on an actual change.
+    kk_apply_user_shader(p, p->gpu, &p->rparams, &p->user_hook, &p->user_shader_path);
+    kk_apply_deband(p, &p->rparams, &p->deband_mode);
+
+    struct pl_frame img;
+    pl_tex src_tex[2] = { NULL, NULL };
+    if (!hybrid_wrap_pixbuf(p, pb, &img, src_tex))
+        return -2;
+
+    pl_tex target_tex = pl_metal_wrap_tex(p->metal, target_texture);
+    if (!target_tex) {
+        pl_tex_destroy(p->gpu, &src_tex[0]);
+        pl_tex_destroy(p->gpu, &src_tex[1]);
+        return -3;
+    }
+
+    // Y-orientation: CVPixelBuffer + CAMetalDrawable are both top-left origin,
+    // but libplacebo's swapchain convention may need a flip (the mpv path runs
+    // with FLIP_Y=1 since the mpv-master upgrade). Env toggle so the on-device
+    // orientation can be corrected without a rebuild; settle on the constant
+    // once verified.
+    const char *flipenv = getenv("KUCKUCK_HYBRID_FLIP");
+    bool flip = flipenv && flipenv[0] == '1';
+    // Increment 3 (HDR): target colour space from the drawable's pixel format,
+    // wie der mpv-Render-Pfad. Ein float-Drawable (rgba16Float, vom Host fuer
+    // EDR/HDR-Output gesetzt) bekommt ein HDR10-Target -> der Renderer tone-mappt
+    // in HDR statt auf SDR zu clippen; ein 8/10-bit-unorm-Drawable bleibt sRGB.
+    // Die Source (P010, BT.2020/PQ) labelt hybrid_wrap_pixbuf bereits korrekt via
+    // primaries/transfer. max_luma auf die reale EDR-Peak deckeln (KUCKUCK_HDR_
+    // TARGET_NITS), sonst grell; KUCKUCK_HDR_TARGET=hdr10 = altes ungedeckeltes.
+    bool hdr_target = target_tex->params.format &&
+                      target_tex->params.format->type == PL_FMT_FLOAT;
+    p->rparams.peak_detect_params = hdr_target ? &pl_peak_detect_high_quality_params : NULL;
+    struct pl_color_space hdr_csp = pl_color_space_hdr10;
+    {
+        const char *hmode = getenv("KUCKUCK_HDR_TARGET");
+        const char *hnits = getenv("KUCKUCK_HDR_TARGET_NITS");
+        if (!(hmode && strcmp(hmode, "hdr10") == 0))
+            hdr_csp.hdr.max_luma = hnits ? (float) atof(hnits) : 1000.0f;
+    }
+    struct pl_swapchain_frame sw_frame = {
+        .fbo         = target_tex,
+        .flipped     = flip,
+        .color_repr  = pl_color_repr_rgb,
+        .color_space = hdr_target ? hdr_csp : pl_color_space_srgb,
+    };
+    struct pl_frame target;
+    pl_frame_from_swapchain(&target, &sw_frame);
+
+    // Aspect-correct letterbox: fit the source into the drawable, centred, and
+    // let libplacebo clear the bars to black (pl_frame_from_swapchain defaulted
+    // target.crop to the whole drawable = stretch-to-fill).
+    float tw = target_tex->params.w, th = target_tex->params.h;
+    float sw = img.crop.x1 - img.crop.x0, sh = img.crop.y1 - img.crop.y0;
+    if (sw > 0 && sh > 0 && tw > 0 && th > 0) {
+        float src_ar = sw / sh, dst_ar = tw / th;
+        if (src_ar > dst_ar) {           // source wider → bars top/bottom
+            float fh = tw / src_ar, y0 = (th - fh) / 2.0f;
+            target.crop = (struct pl_rect2df) { .x0 = 0, .y0 = y0, .x1 = tw, .y1 = y0 + fh };
+        } else {                          // source taller → bars left/right
+            float fw = th * src_ar, x0 = (tw - fw) / 2.0f;
+            target.crop = (struct pl_rect2df) { .x0 = x0, .y0 = 0, .x1 = x0 + fw, .y1 = th };
+        }
+    }
+
+    pl_render_image(p->rr, &img, &target, &p->rparams);
+
+    // Block until the GPU is done so the host can present the drawable right
+    // after this returns (no shared-queue present coordination yet).
+    pl_gpu_finish(p->gpu);
+
+    pl_tex_destroy(p->gpu, &target_tex);
+    pl_tex_destroy(p->gpu, &src_tex[0]);
+    pl_tex_destroy(p->gpu, &src_tex[1]);
+    return 0;
+}
+
+void kuckuck_hybrid_destroy(void *ctx)
+{
+    struct hybrid_priv *p = ctx;
+    if (!p)
+        return;
+    if (p->user_hook)
+        pl_mpv_user_shader_destroy(&p->user_hook);
+    if (p->rr)
+        pl_renderer_destroy(&p->rr);
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "wb");
+            if (f) { pl_cache_save_file(p->cache, f); fclose(f); }
+        }
+        if (p->gpu)
+            pl_gpu_set_cache(p->gpu, NULL);
+        pl_cache_destroy(&p->cache);
+    }
+    if (p->metal)
+        pl_metal_destroy(&p->metal);
+    if (p->pllog)
+        pl_log_destroy(&p->pllog);
+    talloc_free(p);
+}
