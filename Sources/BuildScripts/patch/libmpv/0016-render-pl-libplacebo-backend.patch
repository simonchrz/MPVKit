+// OSD/subtitle overlay caching, mirrors vo_gpu_next: one cached pl_tex per
+// render_index (MAX_OSD_PARTS), reused across frames; the per-part rects are
+// rebuilt each frame into entry->parts and pointed at by an entry in overlays[].
+struct osd_entry {
+    pl_tex tex;
+    struct pl_overlay_part *parts;   // talloc child of priv
+    int num_parts;
+};
+
+struct osd_cache {
+    struct osd_entry entries[MAX_OSD_PARTS];
+    struct pl_overlay overlays[MAX_OSD_PARTS];
+};
+
+struct priv {
+    pl_log pllog;
+    pl_metal metal;          // owns the MTLDevice/queue wrapper
+    pl_gpu gpu;              // == metal->gpu
+    pl_renderer rr;
+    pl_cache cache;          // persisted GLSL->MSL transpile cache (disk-backed)
+
+    struct mp_image_params img_params;
+    struct mp_rect src, dst;
+    struct mp_osd_res osd;
+
+    // OSD/subtitle compositing. osd_state is vo->osd (borrowed, set in
+    // update_external); osd_render() is called per frame at the current pts and
+    // the resulting bitmaps are uploaded as pl_overlay on the target frame.
+    struct osd_state *osd_state;
+    pl_fmt osd_fmt[SUBBITMAP_COUNT];     // r8 (libass A8) / bgra8
+    pl_tex *sub_tex;                     // recycle pool for OSD textures
+    int num_sub_tex;
+    struct osd_cache osd_cache;
+
+    // Frame queue: handles display-time frame selection, deduplication and
+    // (when mpv delivers neighbouring frames) interpolation. Owns the per-frame
+    // plane textures and maps lazily via map_frame_pl.
+    pl_queue queue;
+    uint64_t last_id;        // highest frame_id pushed (skip already-queued)
+    bool want_reset;         // set by reset() (seek); drains the queue next render
+
+    // Optionaler User-Shader (z.B. Anime4K) aus env KUCKUCK_GLSL_SHADER (Datei-
+    // pfad, ein konkatenierter mpv-User-Shader). NULL = kein Hook. rparams =
+    // pl_render_high_quality_params (+ optional der Hook), gemeinsam für Render
+    // und Queue-Radius genutzt.
+    const struct pl_hook *user_hook;
+    char *user_shader_path;  // zuletzt geladener KUCKUCK_GLSL_SHADER-Pfad (strcmp-Cache)
+    bool deint;              // GPU-Deinterlacing an (env KUCKUCK_DEINTERLACE, raw-TS Live-TV)
+    char *deint_algo;        // zuletzt geparster Deinterlace-Algo (strcmp-Cache)
+    struct pl_deinterlace_params deint_params;  // lokale Kopie (algo/skip wählbar via env)
+    char *deband_mode;       // zuletzt angewandter KUCKUCK_DEBAND-Modus (strcmp-Cache)
+    struct pl_render_params rparams;
+};
+
+// Per-source-frame state carried through the pl_queue map/unmap/discard
+// callbacks. frame_data points at one of these.
+struct frame_ref {
+    struct priv *p;          // for the current source crop (p->src)
+    struct mp_image *mpi;    // +1 ref, freed on unmap/discard
+    AVFrame *av;             // alias of mpi's buffers, valid map..unmap
+};
+
+// pl_queue map: mp_image -> AVFrame -> pl_frame, uploading into the queue-owned
+// plane textures. Applies mpv's source crop (panscan/zoom). On failure the
+// queue neither retries nor calls discard, so free our state here.
+static bool map_frame_pl(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src,
+                         struct pl_frame *frame)
+{
+    struct frame_ref *fr = src->frame_data;
+    fr->av = mp_image_to_av_frame(fr->mpi);
+    if (!fr->av) {
+        talloc_free(fr->mpi);
+        talloc_free(fr);
+        return false;
+    }
+    if (!pl_map_avframe_ex(gpu, frame, &(struct pl_avframe_params) {
+            .frame = fr->av, .tex = tex }))
+    {
+        av_frame_free(&fr->av);
+        talloc_free(fr->mpi);
+        talloc_free(fr);
+        return false;
+    }
+    struct mp_rect s = fr->p->src;
+    frame->crop = (struct pl_rect2df) { .x0 = s.x0, .y0 = s.y0, .x1 = s.x1, .y1 = s.y1 };
+    // Deinterlace erzwingen (raw-TS-Frames sind oft NICHT als interlaced
+    // geflaggt): jeden Frame als Top-Field-First markieren → pl_queue/Renderer
+    // deinterlacen (BWDIF). prev/next verwaltet die pl_queue.
+    if (fr->p->deint) {
+        frame->field = PL_FIELD_TOP;
+        frame->first_field = PL_FIELD_TOP;
+    }
+    return true;
+}
+
+static void unmap_frame_pl(pl_gpu gpu, struct pl_frame *frame,
+                           const struct pl_source_frame *src)
+{
+    struct frame_ref *fr = src->frame_data;
+    pl_unmap_avframe(gpu, frame);
+    if (fr->av)
+        av_frame_free(&fr->av);
+    talloc_free(fr->mpi);
+    talloc_free(fr);
+}
+
+static void discard_frame_pl(const struct pl_source_frame *src)
+{
+    struct frame_ref *fr = src->frame_data;
+    talloc_free(fr->mpi);
+    talloc_free(fr);
+}
+
+// Disk path for the shader cache: the app sandbox's Library/Caches (purgeable
+// by iOS under pressure, persistent across launches otherwise). Returns false
+// if HOME is unset or the path doesn't fit.
+static bool pl_cache_file_path(char *buf, size_t size)
+{
+    const char *home = getenv("HOME");
+    if (!home)
+        return false;
+    int n = snprintf(buf, size, "%s/Library/Caches/render_pl_msl.cache", home);
+    return n > 0 && (size_t) n < size;
+}
+
+// Lädt/wechselt den optionalen User-Shader (Anime4K/RAVU) aus env
+// KUCKUCK_GLSL_SHADER. Aufgerufen in pl_init UND pro Frame in pl_render: die App
+// setzt das env pro Video (Content-Gate: Cartoon→Anime4K, Realfilm→RAVU, HD→aus)
+// und der Render-Thread hot-swapt den pl_hook, sobald sich der Pfad ändert.
+// strcmp-Guard → fopen/parse nur bei echtem Wechsel, nicht jeden Frame. Leeres/
+// fehlendes env = kein Hook (Upscaler aus). Braucht p->gpu (in pl_init gesetzt).
+static void pl_apply_user_shader(struct priv *p)
+{
+    const char *path = getenv("KUCKUCK_GLSL_SHADER");
+    if (!path)
+        path = "";
+    const char *cur = p->user_shader_path ? p->user_shader_path : "";
+    if (strcmp(path, cur) == 0)
+        return;  // unverändert → nichts tun (kein fopen pro Frame)
+
+    // Pfad gewechselt → alten Hook weg, neuen laden (oder keinen).
+    if (p->user_hook)
+        pl_mpv_user_shader_destroy(&p->user_hook);
+    p->rparams.hooks = NULL;
+    p->rparams.num_hooks = 0;
+    talloc_free(p->user_shader_path);
+    p->user_shader_path = talloc_strdup(p, path);
+
+    if (!path[0])
+        return;  // env geleert → Upscaler aus
+
+    FILE *sf = fopen(path, "rb");
+    if (!sf)
+        return;
+    fseek(sf, 0, SEEK_END);
+    long ssz = ftell(sf);
+    fseek(sf, 0, SEEK_SET);
+    if (ssz > 0 && ssz < 8 * 1024 * 1024) {
+        char *sbuf = talloc_size(p, ssz + 1);
+        size_t srd = fread(sbuf, 1, ssz, sf);
+        sbuf[srd] = 0;
+        p->user_hook = pl_mpv_user_shader_parse(p->gpu, sbuf, srd);
+        talloc_free(sbuf);
+    }
+    fclose(sf);
+    if (p->user_hook) {
+        p->rparams.hooks = &p->user_hook;   // 1-Element-Array (Adresse des Pointers)
+        p->rparams.num_hooks = 1;
+    }
+}
+
+// Per-Content-Debanding-Presets (G). Default (high_quality) = pl_deband_default_
+// params {1, 3.0, 16, 4.0}. mild = Realfilm, strong = mehr Iterationen für
+// SD-Cartoon-Verläufe. **Grain bewusst auf 1.0** (statt libplacebos 4.0): die
+// IQ-Harness-Messung (2026-06-04) zeigte, dass das strukturelle Debanding der
+// `threshold` folgt, das Grain aber nur Rauschen addiert (TV 252→441) — v.a. auf
+// flachen Cartoon-Flächen sichtbar. Niedriges Grain behält den Banding-Vorteil
+// ohne das Rausch-Manko. HDR → off (Header warnt: Grain verschiebt HDR-Helligkeit).
+static const struct pl_deband_params deband_mild = {
+    .iterations = 1, .threshold = 3.0f, .radius = 16.0f, .grain = 1.0f,
+};
+static const struct pl_deband_params deband_strong = {
+    .iterations = 2, .threshold = 4.0f, .radius = 16.0f, .grain = 1.0f,
+};
+
+// Debanding pro Content via env KUCKUCK_DEBAND: off|mild|strong; unset/anderes =
+// high_quality-Default. App-Gate setzt es pro Video. strcmp-Cache wie der Upscaler
+// (kein Reassign pro Frame). off spart den Deband-Compute-Pass ganz.
+static void pl_apply_deband(struct priv *p)
+{
+    const char *mode = getenv("KUCKUCK_DEBAND");
+    if (!mode)
+        mode = "";
+    const char *cur = p->deband_mode ? p->deband_mode : "";
+    if (strcmp(mode, cur) == 0)
+        return;
+    talloc_free(p->deband_mode);
+    p->deband_mode = talloc_strdup(p, mode);
+
+    if (strcmp(mode, "off") == 0)
+        p->rparams.deband_params = NULL;
+    else if (strcmp(mode, "mild") == 0)
+        p->rparams.deband_params = &deband_mild;
+    else if (strcmp(mode, "strong") == 0)
+        p->rparams.deband_params = &deband_strong;
+    else
+        p->rparams.deband_params = &pl_deband_default_params;  // unset/unbekannt
+}
+
+static int pl_init(struct render_backend *ctx, mpv_render_param *params)
+{
+    // Opt-in gate. render_backend_pl is registered before render_backend_gpu
+    // so it gets first crack at the Metal render API, but stays dormant unless
+    // explicitly enabled — the proven ra_metal path (render_backend_gpu)
+    // handles Metal by default. Set MPV_RENDER_PL=1 in the environment to route
+    // Metal rendering through libplacebo instead. Reversible without a rebuild;
+    // instant fallback by unsetting it. Remove this gate once validated.
+    const char *optin = getenv("MPV_RENDER_PL");
+    if (!optin || optin[0] != '1')
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    ctx->priv = talloc_zero(NULL, struct priv);
+    struct priv *p = ctx->priv;
+
+    // Only the Metal render API is supported for now.
+    char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
+    if (!api || strcmp(api, MPV_RENDER_API_TYPE_METAL) != 0)
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    mpv_metal_init_params *init =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_INIT_PARAMS, NULL);
+    if (!init || !init->device) {
+        MP_FATAL(ctx, "MPV_RENDER_PARAM_METAL_INIT_PARAMS.device is required.\n");
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    p->pllog = mppl_log_create(p, ctx->log);
+    if (!p->pllog)
+        return MPV_ERROR_GENERIC;
+
+    p->metal = pl_metal_create(p->pllog, pl_metal_params(
+        .device = init->device,
+    ));
+    if (!p->metal) {
+        MP_FATAL(ctx, "Failed creating libplacebo Metal device.\n");
+        return MPV_ERROR_GENERIC;
+    }
+    p->gpu = p->metal->gpu;
+
+    // OSD overlay texture formats: libass parts are A8 (r8), BGRA parts are
+    // premultiplied bgra8. Looked up once; NULL if unsupported (skipped later).
+    p->osd_fmt[SUBBITMAP_LIBASS] = pl_find_named_fmt(p->gpu, "r8");
+    p->osd_fmt[SUBBITMAP_BGRA]   = pl_find_named_fmt(p->gpu, "bgra8");
+
+    // Persisted shader cache: the Metal backend stores each pass's transpiled
+    // MSL here (keyed by GLSL hash), so a warm cache loaded from disk lets the
+    // first frame after a cold start skip the ~full-renderer shader transpile
+    // (otherwise several seconds of black). Attach before the renderer compiles
+    // anything (passes are built lazily on first render).
+    p->cache = pl_cache_create(pl_cache_params(
+        .log            = p->pllog,
+        .max_total_size = 16 << 20,   // 16 MiB — comfortably covers the graph
+    ));
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "rb");
+            if (f) {
+                pl_cache_load_file(p->cache, f);
+                fclose(f);
+            }
+        }
+        pl_gpu_set_cache(p->gpu, p->cache);
+    }
+
+    p->rr = pl_renderer_create(p->pllog, p->gpu);
+    if (!p->rr)
+        return MPV_ERROR_GENERIC;
+
+    // High-Quality-Render-Params (Debanding + ewa_lanczos + Sigmoid). Optional ein
+    // User-Shader (Anime4K etc.) aus env KUCKUCK_GLSL_SHADER: eine Datei mit einem
+    // (ggf. konkatenierten) mpv-User-Shader → pl_hook → params.hooks. App schaltet
+    // das per env (Toggle + Animation-Gate); fehlt es, identisch zu renderpl.19.
+    p->rparams = pl_render_high_quality_params;
+    // Error-Diffusion-Dithering (sierra-lite): besser als ordered Dithering gegen
+    // Banding in Verläufen (dunkle Cartoon-Szenen, SD→Retina). Billiger Compute-Pass.
+    p->rparams.error_diffusion = &pl_error_diffusion_sierra_lite;
+    pl_apply_user_shader(p);   // initialer Shader aus env (App-Gate); pl_render recheckt
+    pl_apply_deband(p);        // initiales Deband-Preset aus env (App-Gate)
+
+    p->queue = pl_queue_create(p->gpu);
+    if (!p->queue)
+        return MPV_ERROR_GENERIC;
+
+    ctx->driver_caps = VO_CAP_ROTATE90;
+    return 0;
+}
+
+static bool pl_check_format(struct render_backend *ctx, int imgfmt)
+{
+    struct priv *p = ctx->priv;
+    // A format is renderable if libplacebo's libav mapper can describe it.
+    // pl_test_pixfmt checks the underlying AVPixelFormat against the gpu's
+    // capabilities without needing an actual frame.
+    enum AVPixelFormat avfmt = imgfmt2pixfmt(imgfmt);
+    if (avfmt == AV_PIX_FMT_NONE)
+        return false;
+    return pl_test_pixfmt(p->gpu, avfmt);
+}
+
+static int pl_set_parameter(struct render_backend *ctx, mpv_render_param param)
+{
+    (void) ctx; (void) param;
+    return MPV_ERROR_NOT_IMPLEMENTED;
+}
+
+static void pl_reconfig(struct render_backend *ctx, struct mp_image_params *params)
+{
+    struct priv *p = ctx->priv;
+    p->img_params = *params;
+}
+
+static void pl_resize(struct render_backend *ctx, struct mp_rect *src,
+                      struct mp_rect *dst, struct mp_osd_res *osd)
+{
+    struct priv *p = ctx->priv;
+    p->src = *src;
+    p->dst = *dst;
+    p->osd = *osd;
+}
+
+static int pl_get_target_size(struct render_backend *ctx, mpv_render_param *params,
+                              int *out_w, int *out_h)
+{
+    mpv_metal_drawable *dr =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_DRAWABLE, NULL);
+    if (!dr || !dr->texture)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out_w = dr->w;
+    *out_h = dr->h;
+    (void) ctx;
+    return 0;
+}
+
+// Render mpv's OSD + subtitles at the given pts into pl_overlay structs and
+// attach them to the target frame. Ported from vo_gpu_next's update_overlays:
+// osd_render() returns packed bitmaps (A8 for libass, premultiplied BGRA for
+// image subs), which we upload into per-render_index cached textures and
+// describe as overlay parts. Coordinates are in the OSD resolution = the full
+// output (PL_OVERLAY_COORDS_DST_FRAME), so subs can land in the letterbox too.
+static void update_osd(struct priv *p, struct pl_frame *target, double pts)
+{
+    target->num_overlays = 0;
+    target->overlays = NULL;
+    if (!p->osd_state)
+        return;
+
+    struct sub_bitmap_list *subs =
+        osd_render(p->osd_state, p->osd, pts, 0, mp_draw_sub_formats);
+    if (!subs)
+        return;
+
+    struct osd_cache *cache = &p->osd_cache;
+    for (int n = 0; n < subs->num_items; n++) {
+        const struct sub_bitmaps *item = subs->items[n];
+        if (!item->num_parts || !item->packed)
+            continue;
+        if (item->render_index < 0 || item->render_index >= MAX_OSD_PARTS)
+            continue;
+        pl_fmt tex_fmt = p->osd_fmt[item->format];
+        if (!tex_fmt)
+            continue;
+        struct osd_entry *entry = &cache->entries[item->render_index];
+
+        // Reuse a pooled texture if this entry doesn't have one yet.
+        if (!entry->tex && p->num_sub_tex)
+            MP_TARRAY_POP(p->sub_tex, p->num_sub_tex, &entry->tex);
+        bool ok = pl_tex_recreate(p->gpu, &entry->tex, &(struct pl_tex_params) {
+            .format        = tex_fmt,
+            .w             = MPMAX(item->packed_w, entry->tex ? entry->tex->params.w : 0),
+            .h             = MPMAX(item->packed_h, entry->tex ? entry->tex->params.h : 0),
+            .host_writable = true,
+            .sampleable    = true,
+        });
+        if (!ok)
+            break;
+
+        struct pl_tex_transfer_params tr = {
+            .tex       = entry->tex,
+            .rc        = { .x1 = item->packed_w, .y1 = item->packed_h },
+            .row_pitch = item->packed->stride[0],
+            .ptr       = item->packed->planes[0],
+        };
+        // Async uploads read the source after this returns: keep the packed
+        // image alive via a ref freed by the upload callback.
+        if (p->gpu->limits.callbacks) {
+            tr.callback = talloc_free;
+            tr.priv     = mp_image_new_ref(item->packed);
+        }
+        ok = pl_tex_upload(p->gpu, &tr);
+        if (!ok) {
+            if (tr.priv)
+                talloc_free(tr.priv);
+            break;
+        }
+
+        entry->num_parts = 0;
+        for (int i = 0; i < item->num_parts; i++) {
+            const struct sub_bitmap *b = &item->parts[i];
+            if (b->dw == 0 || b->dh == 0)
+                continue;
+            uint32_t c = b->libass.color;   // RGBA packed, only used for libass
+            struct pl_overlay_part part = {
+                .src = { b->src_x, b->src_y, b->src_x + b->w, b->src_y + b->h },
+                .dst = { b->x, b->y, b->x + b->dw, b->y + b->dh },
+                .color = {
+                    (c >> 24) / 255.0f,
+                    ((c >> 16) & 0xFF) / 255.0f,
+                    ((c >> 8) & 0xFF) / 255.0f,
+                    (255 - (c & 0xFF)) / 255.0f,
+                },
+            };
+            MP_TARRAY_APPEND(p, entry->parts, entry->num_parts, part);
+        }
+
+        struct pl_overlay *ol = &cache->overlays[target->num_overlays++];
+        *ol = (struct pl_overlay) {
+            .tex       = entry->tex,
+            .parts     = entry->parts,
+            .num_parts = entry->num_parts,
+            .color     = pl_color_space_srgb,
+            .coords    = PL_OVERLAY_COORDS_DST_FRAME,
+        };
+        switch (item->format) {
+        case SUBBITMAP_BGRA:
+            ol->mode = PL_OVERLAY_NORMAL;
+            ol->repr.alpha = PL_ALPHA_PREMULTIPLIED;
+            break;
+        case SUBBITMAP_LIBASS:
+            ol->mode = PL_OVERLAY_MONOCHROME;
+            ol->repr.alpha = PL_ALPHA_INDEPENDENT;
+            break;
+        default:
+            break;
+        }
+    }
+
+    if (target->num_overlays)
+        target->overlays = cache->overlays;
+    talloc_free(subs);
+}
+
+// H-Instrumentierung (temporär): misst die pl_gpu_finish-Dauer = wie lange der
+// Render-Thread pro Frame blockiert, bis die GPU fertig ist. Dumpt avg/max alle
+// 300 Frames nach Documents/gpu-finish.log — NUR wenn env KUCKUCK_GPU_PROFILE
+// gesetzt ist; sonst nackter pl_gpu_finish ohne jeden Overhead. Belegt objektiv,
+// ob der Cross-Queue-Barrier-Stall relevant genug für den H-Redesign ist.
+static void gpu_finish_profiled(struct priv *p)
+{
+    if (!getenv("KUCKUCK_GPU_PROFILE")) {
+        pl_gpu_finish(p->gpu);
+        return;
+    }
+    static uint64_t n, sum_ns, max_ns;
+    uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    pl_gpu_finish(p->gpu);
+    uint64_t dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0;
+    sum_ns += dt; n++;
+    if (dt > max_ns) max_ns = dt;
+    if (n >= 300) {
+        const char *home = getenv("HOME");
+        char path[PATH_MAX];
+        if (home && snprintf(path, sizeof path, "%s/Documents/gpu-finish.log", home) < (int) sizeof path) {
+            FILE *f = fopen(path, "a");
+            if (f) {
+                fprintf(f, "gpu_finish avg=%.1fus max=%.1fus n=%llu\n",
+                        sum_ns / (double) n / 1000.0, max_ns / 1000.0, (unsigned long long) n);
+                fclose(f);
+            }
+        }
+        n = 0; sum_ns = 0; max_ns = 0;
+    }
+}
+
+static int pl_render(struct render_backend *ctx, mpv_render_param *params,
+                     struct vo_frame *frame)
+{
+    struct priv *p = ctx->priv;
+
+    // Pro-Video Hot-Swap des User-Shaders + Deband-Presets (App setzt env pro
+    // Content-Gate). Billiger strcmp-Guard; wechselt nur bei echtem Wechsel.
+    pl_apply_user_shader(p);
+    pl_apply_deband(p);
+
+    // GPU-Deinterlacing (A): App setzt KUCKUCK_DEINTERLACE für raw-TS-Tuner-Live-TV
+    // (576i, oft NICHT als interlaced geflaggt → erzwungen statt am Flag). pl_queue
+    // rendert pro Feld. map_frame_pl markt das Feld. Wert wählt den Algorithmus:
+    //   "1"/"bwdif" = BWDIF (beste, schwerste) · "yadif" = YADIF · "yadif-fast" =
+    //   YADIF+skip_spatial_check (leichter) · "bob" = Zeilenverdopplung (am leichtesten).
+    // Ziel: schärfste Stufe finden, die stabil 50p hält (App-Picker schaltet live um).
+    const char *di = getenv("KUCKUCK_DEINTERLACE");
+    p->deint = di && di[0] != '\0' && strcmp(di, "0") != 0;
+    if (p->deint && (!p->deint_algo || strcmp(p->deint_algo, di) != 0)) {
+        talloc_free(p->deint_algo);
+        p->deint_algo = talloc_strdup(p, di);
+        p->deint_params = pl_deinterlace_default_params;  // BWDIF-Basis
+        if (strcmp(di, "yadif") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_YADIF;
+        } else if (strcmp(di, "yadif-fast") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_YADIF;
+            p->deint_params.skip_spatial_check = true;
+        } else if (strcmp(di, "bob") == 0) {
+            p->deint_params.algo = PL_DEINTERLACE_BOB;
+        }  // "1"/"bwdif"/sonst → Default (BWDIF)
+    }
+    p->rparams.deinterlace_params = p->deint ? &p->deint_params : NULL;
+
+    // Resolution-Render-Gate: ab ≥1080p-Quelle den teuren POLAREN ewa_lanczossharp-
+    // Upscaler durch einen SEPARABLEN Lanczos ersetzen. 1080p→Retina ist ein
+    // moderater Upscale (~2,4×) → optisch nahezu identisch, aber der Polar-Scaler
+    // war render-gebunden (~50ms/Frame → HD-Sport fiel auf 25 statt 50fps). 720p/SD
+    // behalten den polaren HQ-Scaler (dort hält's 50fps). KUCKUCK_HD_LIGHT=0 → aus (A/B).
+    int src_h = (frame && frame->current) ? frame->current->h : 0;
+    const char *hl = getenv("KUCKUCK_HD_LIGHT");
+    if (!(hl && hl[0] == '0') && (src_h >= 1080 || p->deint)) {
+        // Light-Render-Pfad: separabler Scaler + Deband + Error-Diffusion-Dither weg.
+        // Greift bei (a) HD ≥1080p (App rendert ~quell-aufgelöst → Budget eng) UND
+        // (b) Deinterlacing (raw-TS 576i: das per-Feld-50p-Deint ist schon teuer, der
+        // schwere polare Scaler + Dither obendrauf reißt das 60Hz-Budget → ~22fps).
+        // Dither/Deband sind auf dem stark hochskalierten SD/HD-Bild kaum sichtbar.
+        p->rparams.upscaler = &pl_filter_lanczos;
+        p->rparams.deband_params = NULL;
+        p->rparams.error_diffusion = NULL;
+    } else {
+        // SD/720p: polarer HQ-Scaler + Dither. Deband authoritativ aus dem env neu
+        // bestimmen (pl_apply_deband-strcmp-Cache hat es nach HD evtl. nicht restored).
+        p->rparams.upscaler = pl_render_high_quality_params.upscaler;
+        p->rparams.error_diffusion = &pl_error_diffusion_sierra_lite;
+        const char *dm = getenv("KUCKUCK_DEBAND");
+        if (dm && strcmp(dm, "off") == 0)         p->rparams.deband_params = NULL;
+        else if (dm && strcmp(dm, "mild") == 0)   p->rparams.deband_params = &deband_mild;
+        else if (dm && strcmp(dm, "strong") == 0) p->rparams.deband_params = &deband_strong;
+        else                                      p->rparams.deband_params = &pl_deband_default_params;
+    }
+
+    mpv_metal_drawable *dr =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_DRAWABLE, NULL);
+    if (!dr || !dr->texture)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // 1. Wrap the caller's destination texture as a libplacebo render target.
+    pl_tex target_tex = pl_metal_wrap_tex(p->metal, dr->texture);
+    if (!target_tex)
+        return MPV_ERROR_GENERIC;
+
+    // Target colour space derived from the drawable's pixel format instead of
+    // hardcoded: an 8/10-bit unorm drawable is sRGB; a float drawable (set up
+    // by the host for EDR/HDR output) gets an HDR10 target so the renderer
+    // tone-maps into HDR rather than clipping to SDR.
+    bool hdr_target = target_tex->params.format &&
+                      target_tex->params.format->type == PL_FMT_FLOAT;
+    struct pl_swapchain_frame sw_frame = {
+        .fbo         = target_tex,
+        .flipped     = false,
+        .color_repr  = pl_color_repr_rgb,
+        .color_space = hdr_target ? pl_color_space_hdr10 : pl_color_space_srgb,
+    };
+    struct pl_frame target;
+    pl_frame_from_swapchain(&target, &sw_frame);
+
+    // Aspect-correct placement: mpv computed the on-screen video rect (dst,
+    // letterboxed within the drawable) in resize(). pl_frame_from_swapchain
+    // defaults target.crop to the whole drawable, which would stretch the video
+    // to fill — override with mpv's dst rect so the renderer letterboxes (the
+    // area outside the crop is cleared to black). The source crop (src) is
+    // applied per-frame in map_frame_pl.
+    target.crop = (struct pl_rect2df) {
+        .x0 = p->dst.x0, .y0 = p->dst.y0,
+        .x1 = p->dst.x1, .y1 = p->dst.y1,
+    };
+
+    // 2. Feed the frame queue. mpv hands us the current frame plus any
+    //    neighbours it wants available for display-synced interpolation
+    //    (frame->frames[]); the queue dedups by frame_id, maps lazily and
+    //    evicts past frames. On seek mpv calls reset() -> want_reset, which we
+    //    drain here so the queue restarts cleanly at the new position.
+    //
+    // Interpolation parity with vo_gpu_next (Kuckuck #3): only blend when mpv
+    // actually display-syncs a multi-frame window (interpolation=yes). For the
+    // single-frame path (interpolation=no -> num_frames==1) can_interpolate is
+    // false and pts_offset / vsync_duration / source duration are 0 — the queue
+    // holds exactly the current frame at its pts, nothing is blended (the path
+    // that was the only one tested before). Without this distinction a naive
+    // multi-frame mix renders black: the target display time is pts +
+    // ideal_frame_vsync, and querying the queue at the bare current->pts (no
+    // offset, no clamp) returns PL_QUEUE_MORE with no frames -> empty mix.
+    bool can_interpolate = frame && frame->current && frame->display_synced &&
+                           !frame->still && frame->num_frames > 1;
+    double pts_offset = can_interpolate ? frame->ideal_frame_vsync : 0;
+
+    // Queue-refill guard (vo_gpu_next): if the queue's front frame is already
+    // ahead of our target pts, the queue desynced (e.g. seek) — force a reset so
+    // it refills cleanly instead of returning an empty (black) mix. Skipped when
+    // a reset is already pending (mpv's reset() on seek sets want_reset first).
+    if (frame && frame->current && !p->want_reset) {
+        struct pl_source_frame vpts;
+        if (pl_queue_peek(p->queue, 0, &vpts) &&
+            frame->current->pts + MPMAX(0, pts_offset) < vpts.pts)
+            p->want_reset = true;
+    }
+    if (p->want_reset) {
+        pl_queue_reset(p->queue);
+        p->last_id = 0;
+        p->want_reset = false;
+    }
+    for (int n = 0; frame && n < frame->num_frames; n++) {
+        uint64_t id = frame->frame_id + n;
+        if (id <= p->last_id)
+            continue;  // already queued in an earlier render call
+        struct mp_image *mpi = mp_image_new_ref(frame->frames[n]);
+        if (!mpi)
+            continue;
+        struct frame_ref *fr = talloc_zero(NULL, struct frame_ref);
+        fr->p   = p;
+        fr->mpi = mpi;
+        pl_queue_push(p->queue, &(struct pl_source_frame) {
+            .pts        = mpi->pts,
+            .duration   = can_interpolate ? frame->approx_duration : 0,
+            .frame_data = fr,
+            .map        = map_frame_pl,
+            .unmap      = unmap_frame_pl,
+            .discard    = discard_frame_pl,
+        });
+        p->last_id = id;
+    }
+
+    // 3. Pull the frame mix for the current display time. With interpolation the
+    //    target is pts + pts_offset and vsync_duration drives the blend; without
+    //    it both are 0 and the mix holds the single current frame.
+    struct pl_frame_mix mix = {0};
+    enum pl_queue_status st = PL_QUEUE_OK;
+    if (frame && frame->current) {
+        struct pl_queue_params qparams = *pl_queue_params(
+            .pts                     = frame->current->pts + pts_offset,
+            // Kuckuck: high-quality statt default render-params (Debanding +
+            // ewa_lanczos-Upscaler + Sigmoid). Radius MUSS zu den Render-params
+            // passen (Interpolations-Konsistenz).
+            .radius                  = pl_frame_mix_radius(&p->rparams),
+            .vsync_duration          = can_interpolate ? frame->ideal_frame_vsync_duration : 0,
+            .interpolation_threshold = 0.01,  // mpv-Default: nahe 1:1-Ratio nicht blenden
+        );
+        // We may be up to half a vsync before the current frame time. If the
+        // queue's first frame is ahead of the requested pts, start there —
+        // otherwise pl_queue returns MORE with an empty mix (black).
+        struct pl_source_frame first;
+        if (pl_queue_peek(p->queue, 0, &first) && qparams.pts < first.pts)
+            qparams.pts = first.pts;
+        st = pl_queue_update(p->queue, &mix, &qparams);
+    }
+
+    // 3b. OSD + subtitles at the current display pts → pl_overlay on the
+    //     target. Composited by pl_render_image_mix in the same pass.
+    double osd_pts = (frame && frame->current) ? frame->current->pts : 0;
+    update_osd(p, &target, osd_pts);
+
+    // 4. Render. An empty mix (e.g. right after a seek, before frames arrive)
+    //    clears the target; PL_QUEUE_MORE still yields the available frames.
+    if (st != PL_QUEUE_ERR)
+        pl_render_image_mix(p->rr, &mix, &target, &p->rparams);
+
+    // 5. Block until the GPU work is COMPLETE before the caller presents the
+    //    drawable. Load-bearing: libplacebo renders on its own Metal queue, the
+    //    host presents via bare [drawable present] on its own path — this finish
+    //    is the only cross-queue barrier. (H-Backlog: flush statt finish bräuchte
+    //    MTLSharedEvent-Sync. gpu_finish_profiled misst die Stall-Dauer wenn
+    //    KUCKUCK_GPU_PROFILE gesetzt — sonst nackter finish, kein Overhead.)
+    gpu_finish_profiled(p);
+
+    pl_tex_destroy(p->gpu, &target_tex);
+
+    (void) ctx;
+    return 0;
+}
+
+// mpv sets need_reset on seek/reconfig. Defer the actual pl_queue_reset to the
+// next render (same render thread, just before the push loop) so we never touch
+// the queue concurrently and the new frames repopulate it in one place.
+static void pl_reset(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+    p->want_reset = true;
+}
+
+// mpv sets need_update_external on first frame + when the VO's OSD/overlay
+// source changes. We borrow vo->osd here (lifetime managed by the player) and
+// call osd_render() against it each frame in update_osd. vo may be NULL — then
+// OSD is simply skipped.
+static void pl_update_external(struct render_backend *ctx, struct vo *vo)
+{
+    struct priv *p = ctx->priv;
+    p->osd_state = vo ? vo->osd : NULL;
+}
+
+static void pl_destroy(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p)
+        return;
+    // Destroys the queue first: it unmaps/discards every cached frame (freeing
+    // the AVFrames + mp_image refs) and the plane textures it owns.
+    pl_queue_destroy(&p->queue);
+    pl_renderer_destroy(&p->rr);
+    if (p->user_hook)
+        pl_mpv_user_shader_destroy(&p->user_hook);
+    // Flush the (now warm) shader cache back to disk, then detach it from the
+    // gpu before the gpu itself is destroyed.
+    if (p->cache) {
+        char path[PATH_MAX];
+        if (pl_cache_file_path(path, sizeof(path))) {
+            FILE *f = fopen(path, "wb");
+            if (f) {
+                pl_cache_save_file(p->cache, f);
+                fclose(f);
+            }
+        }
+        if (p->gpu)
+            pl_gpu_set_cache(p->gpu, NULL);
+        pl_cache_destroy(&p->cache);
+    }
+    // OSD textures (cached entries + recycle pool). entry->parts are talloc
+    // children of p and freed with ctx->priv.
+    if (p->gpu) {
+        for (int i = 0; i < MAX_OSD_PARTS; i++)
+            pl_tex_destroy(p->gpu, &p->osd_cache.entries[i].tex);
+        for (int i = 0; i < p->num_sub_tex; i++)
+            pl_tex_destroy(p->gpu, &p->sub_tex[i]);
+    }
+    pl_metal_destroy(&p->metal);
+    // p->pllog is a talloc child of p; freed with ctx->priv.
+}
+
+const struct render_backend_fns render_backend_pl = {
+    .init            = pl_init,
+    .check_format    = pl_check_format,
+    .set_parameter   = pl_set_parameter,
+    .reconfig        = pl_reconfig,
+    .reset           = pl_reset,
+    .update_external = pl_update_external,
+    .resize          = pl_resize,
+    .get_target_size = pl_get_target_size,
+    .render          = pl_render,
+    .destroy         = pl_destroy,
+};
