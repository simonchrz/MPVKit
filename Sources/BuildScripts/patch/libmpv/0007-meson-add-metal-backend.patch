diff --git a/meson.build b/meson.build
index 7efc2db..3d9075a 100644
--- a/meson.build
+++ b/meson.build
@@ -1013,7 +1013,7 @@ if features['sdl2-video']
 endif
 
 shaderc = dependency('shaderc', required:
-    get_option('shaderc').require(features['win32-desktop']))
+    get_option('shaderc').require(features['win32-desktop'] or (darwin and get_option('metal').allowed())))
 features += {'shaderc': shaderc.found()}
 if features['shaderc']
     dependencies += shaderc
@@ -1033,7 +1033,7 @@ if features['posix']
 endif
 
 spirv_cross = dependency('spirv-cross-c-shared', required:
-    get_option('spirv-cross').require(features['win32-desktop']))
+    get_option('spirv-cross').require(features['win32-desktop'] or (darwin and get_option('metal').allowed())))
 features += {'spirv-cross': spirv_cross.found()}
 if features['spirv-cross']
     dependencies += spirv_cross
@@ -1347,6 +1347,27 @@ if features['vulkan'] and features['x11']
      sources += files('video/out/vulkan/context_xlib.c')
 endif
 
+# Apple Metal render backend.
+# Needs shaderc (GLSL -> SPIR-V) and spirv-cross (SPIR-V -> MSL), mirroring d3d11.
+metal_opt = get_option('metal').require(
+    darwin and features['shaderc'] and features['spirv-cross'],
+    error_message: 'Metal backend needs darwin platform plus shaderc and spirv-cross.',
+)
+metal_dep = dependency('appleframeworks', modules: ['Metal', 'Foundation'],
+                       required: metal_opt)
+features += {'metal': metal_dep.found()}
+if features['metal']
+    dependencies += metal_dep
+    sources += files(
+        # libplacebo-driven render-API backend (future-proofing vs vo_gpu)
+        'video/out/render_pl.c',
+    )
+    add_project_arguments('-DMPV_HAVE_METAL=1', language: ['c', 'cpp', 'objc'])
+endif
+
 features += {'vk-khr-display': vulkan.type_name() == 'internal' or
                                cc.has_function('vkCreateDisplayPlaneSurfaceKHR', prefix: '#include <vulkan/vulkan_core.h>',
                                                dependencies: [vulkan])}
@@ -1823,7 +1844,8 @@ if get_option('libmpv')
                  description: 'mpv media player client library')
 
     headers = ['include/mpv/client.h', 'include/mpv/render.h',
-               'include/mpv/render_gl.h', 'include/mpv/stream_cb.h']
+               'include/mpv/render_gl.h', 'include/mpv/render_mtl.h',
+               'include/mpv/stream_cb.h']
     install_headers(headers, subdir: 'mpv')
 
     # Allow projects to build with libmpv by cloning into ./subprojects/mpv
diff --git a/meson.options b/meson.options
index 35e174c..ac4685e 100644
--- a/meson.options
+++ b/meson.options
@@ -106,6 +106,7 @@ option('gl-dxinterop-d3d9', type: 'feature', value: 'auto', description: 'OpenGL
 option('ios-gl', type: 'feature', value: 'auto', description: 'iOS OpenGL ES interop support')
 option('videotoolbox-gl', type: 'feature', value: 'auto', description: 'Videotoolbox with OpenGL')
 option('videotoolbox-pl', type: 'feature', value: 'auto', description: 'Videotoolbox with libplacebo')
+option('metal', type: 'feature', value: 'auto', description: 'Apple Metal render backend (macOS/iOS only)')
 
 # macOS features
 option('macos-10-15-4-features', type: 'feature', value: 'auto', description: 'macOS 10.15.4 SDK Features')
