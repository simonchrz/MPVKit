+#ifndef MPV_CLIENT_API_RENDER_MTL_H_
+#define MPV_CLIENT_API_RENDER_MTL_H_
+
+#include "render.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Metal backend
+ * -------------
+ *
+ * This header defines the Apple Metal backend for the mpv render API
+ * (render.h). It targets iOS / macOS and is intended as a replacement for
+ * the deprecated OpenGL ES path on iOS.
+ *
+ * Unlike the OpenGL backend, there is no implicit per-thread context — Metal
+ * is fully explicit. The API user provides an `id<MTLDevice>` at init time;
+ * mpv allocates command queues, libraries, pipeline states and buffers from
+ * that device.
+ *
+ * Shaders
+ * -------
+ *
+ * mpv's renderer (vo_gpu / vo_gpu_next) emits Vulkan-flavoured GLSL. The
+ * Metal backend compiles that to SPIR-V via shaderc (already a build
+ * dependency for the Vulkan-only RA) and then translates SPIR-V to MSL via
+ * SPIRV-Cross (already a build dependency for the D3D11 RA). Pipeline state
+ * objects are cached per renderpass.
+ *
+ * API use
+ * -------
+ *
+ * Use mpv_render_context_create() with:
+ *   - MPV_RENDER_PARAM_API_TYPE = MPV_RENDER_API_TYPE_METAL
+ *   - MPV_RENDER_PARAM_METAL_INIT_PARAMS = pointer to a populated
+ *     `mpv_metal_init_params` describing the `id<MTLDevice>` to use.
+ *
+ * Call mpv_render_context_render() with MPV_RENDER_PARAM_METAL_DRAWABLE to
+ * render the video frame into a Metal texture (typically the `texture`
+ * property of a CAMetalDrawable obtained from a CAMetalLayer).
+ *
+ * Hardware decoding
+ * -----------------
+ *
+ * VideoToolbox hardware-decoded surfaces (CVPixelBuffer) are imported into
+ * Metal via CVMetalTextureCache. The backend handles this transparently when
+ * `hwdec=videotoolbox` is selected.
+ */
+
+/**
+ * For MPV_RENDER_PARAM_API_TYPE. The corresponding init-params struct is
+ * mpv_metal_init_params.
+ */
+#define MPV_RENDER_API_TYPE_METAL "metal"
+
+/**
+ * For MPV_RENDER_PARAM_METAL_INIT_PARAMS.
+ *
+ * The `device` field is an `id<MTLDevice>` opaque pointer. The lifetime of
+ * the device must exceed the lifetime of the mpv_render_context.
+ */
+typedef struct mpv_metal_init_params {
+    /**
+     * Opaque pointer to an `id<MTLDevice>`. Bridge-cast from Objective-C with
+     * `(__bridge void *)device`, or `(__bridge_retained void *)device` if the
+     * caller wants mpv to own a reference. Required.
+     */
+    void *device;
+
+    /**
+     * Optional opaque pointer to an `id<MTLCommandQueue>`. If NULL, mpv
+     * creates its own queue from `device`. Provide one to share scheduling
+     * with other Metal work in the host app.
+     */
+    void *command_queue;
+} mpv_metal_init_params;
+
+/**
+ * For MPV_RENDER_PARAM_METAL_DRAWABLE. Describes the destination texture
+ * for a single mpv_render_context_render() call.
+ */
+typedef struct mpv_metal_drawable {
+    /**
+     * Opaque pointer to an `id<MTLTexture>` that mpv will render into.
+     * Typically the `.texture` property of a `CAMetalDrawable` acquired
+     * from `[CAMetalLayer nextDrawable]`. The texture's `pixelFormat`
+     * must be color-renderable; mpv supports BGRA8Unorm, RGBA8Unorm,
+     * BGRA10A2Unorm and RGBA16Float.
+     */
+    void *texture;
+
+    /**
+     * Valid dimensions of the texture in pixels. Both must be > 0.
+     */
+    int w, h;
+
+    /**
+     * Optional `id<MTLCommandBuffer>` opaque pointer. If non-NULL, mpv
+     * encodes its render commands into this buffer (so the host app can
+     * batch present + other work on a single buffer + commit once). If
+     * NULL, mpv allocates a fresh command buffer per render call.
+     */
+    void *command_buffer;
+} mpv_metal_drawable;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/video/out/metal/libmpv_metal.m b/video/out/metal/libmpv_metal.m
new file mode 100644
index 0000000..85ffbf3
--- /dev/null
+++ b/video/out/metal/libmpv_metal.m
@@ -0,0 +1,158 @@
+/*
+ * libmpv Metal backend bridge.
+ *
+ * This file is the Metal-side parallel of video/out/opengl/libmpv_gl.c.
+ * It implements the libmpv_gpu_context_fns interface so that the libmpv
+ * render context dispatcher (libmpv_gpu.c) can drive a Metal-backed ra.
+ *
+ * The heavy lifting (device wrapping, texture import, command-buffer
+ * lifecycle) lives in ra_metal.m; this file just plumbs render-API params
+ * through to that layer.
+ */
+
+#import <Metal/Metal.h>
+
+#include "options/m_config.h"
+#include "mpv/render_mtl.h"
+#include "video/out/gpu/context.h"
+#include "video/out/gpu/libmpv_gpu.h"
+#include "video/out/gpu/ra.h"
+#include "video/out/libmpv.h"
+
+// Forward declarations of the ra_metal helpers. These symbols live in
+// ra_metal.m and resolve at link time; declaring them here keeps libmpv_metal.m
+// independent of ra_metal's internal headers (mirrors how libmpv_gl.c uses
+// ra_gl_ctx_* without pulling in private GL state).
+extern bool ra_init_metal(struct ra_ctx *ctx, id<MTLDevice> device,
+                          id<MTLCommandQueue> queue);
+extern struct ra_tex *ra_metal_wrap_drawable(struct ra_ctx *ctx,
+                                             mpv_metal_drawable *drawable);
+extern void ra_metal_commit_frame(struct ra_ctx *ctx, bool display_synced);
+extern void ra_metal_destroy(struct ra_ctx *ctx);
+
+struct priv {
+    id<MTLDevice> device;
+    id<MTLCommandQueue> queue;
+    struct ra_ctx *ra_ctx;
+};
+
+static int init(struct libmpv_gpu_context *ctx, mpv_render_param *params)
+{
+    ctx->priv = talloc_zero(NULL, struct priv);
+    struct priv *p = ctx->priv;
+
+    mpv_metal_init_params *init_params =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_INIT_PARAMS, NULL);
+    if (!init_params)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    if (!init_params->device) {
+        MP_FATAL(ctx, "MPV_RENDER_PARAM_METAL_INIT_PARAMS.device is NULL.\n");
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    // Bridge-cast without transferring ownership. The caller guarantees the
+    // device outlives the render context (per render_mtl.h contract). If the
+    // caller wants mpv to own a strong reference they can pass a
+    // __bridge_retained pointer; we don't release in destroy either way, which
+    // matches the documented "lifetime exceeds render context" requirement.
+    p->device = (__bridge id<MTLDevice>)init_params->device;
+    if (!p->device) {
+        MP_FATAL(ctx, "Failed to bridge MTLDevice.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    if (init_params->command_queue) {
+        p->queue = (__bridge id<MTLCommandQueue>)init_params->command_queue;
+    } else {
+        p->queue = [p->device newCommandQueue];
+        if (!p->queue) {
+            MP_FATAL(ctx, "Failed to create MTLCommandQueue.\n");
+            return MPV_ERROR_UNSUPPORTED;
+        }
+    }
+
+    // Build a bare ra_ctx that ra_metal will populate. Same shape as the GL
+    // path: vo_libmpv acts as an external swapchain, so there's no real
+    // context_params worth setting beyond allow_sw.
+    p->ra_ctx = talloc_zero(p, struct ra_ctx);
+    p->ra_ctx->log = ctx->log;
+    p->ra_ctx->global = ctx->global;
+    p->ra_ctx->opts = (struct ra_ctx_opts) {
+        .allow_sw = true,
+    };
+
+    if (!ra_init_metal(p->ra_ctx, p->device, p->queue)) {
+        MP_FATAL(ctx, "Metal RA initialization failed.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    // Pick up the user's --gpu-debug toggle so ra_metal can enable the Metal
+    // validation layer / capture scope. Mirrors the GL path's ra_gl_set_debug
+    // dance; ra_metal reads ra_ctx->opts.debug internally.
+    struct ra_ctx_opts *ctx_opts =
+        mp_get_config_group(ctx, ctx->global, &ra_ctx_conf);
+    p->ra_ctx->opts.debug = ctx_opts->debug;
+    talloc_free(ctx_opts);
+
+    ctx->ra_ctx = p->ra_ctx;
+
+    return 0;
+}
+
+static int wrap_fbo(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                    struct ra_tex **out)
+{
+    struct priv *p = ctx->priv;
+
+    mpv_metal_drawable *drawable =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_METAL_DRAWABLE, NULL);
+    if (!drawable)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    if (!drawable->texture || drawable->w <= 0 || drawable->h <= 0) {
+        MP_ERR(ctx, "Invalid mpv_metal_drawable: texture=%p w=%d h=%d.\n",
+               drawable->texture, drawable->w, drawable->h);
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+
+    struct ra_tex *tex = ra_metal_wrap_drawable(p->ra_ctx, drawable);
+    if (!tex) {
+        MP_ERR(ctx, "Failed to wrap MTLTexture as ra_tex.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    *out = tex;
+    return 0;
+}
+
+static void done_frame(struct libmpv_gpu_context *ctx, bool ds)
+{
+    struct priv *p = ctx->priv;
+
+    // Metal equivalent of ra_gl_ctx_submit_frame: commit the command buffer
+    // that ra_metal has been encoding into. Presentation (presentDrawable:) is
+    // the host app's job — we never own the CAMetalDrawable.
+    ra_metal_commit_frame(p->ra_ctx, ds);
+}
+
+static void destroy(struct libmpv_gpu_context *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    if (p->ra_ctx)
+        ra_metal_destroy(p->ra_ctx);
+
+    // ARC will release p->device / p->queue when the priv talloc block is
+    // freed by libmpv_gpu.c's destroy() (which calls talloc_free(ctx->priv)).
+    // The __bridge cast at init time did not transfer ownership, so the
+    // caller-supplied device is unaffected.
+}
+
+const struct libmpv_gpu_context_fns libmpv_gpu_context_metal = {
+    .api_name = MPV_RENDER_API_TYPE_METAL,
+    .init = init,
+    .wrap_fbo = wrap_fbo,
+    .done_frame = done_frame,
+    .destroy = destroy,
+};
